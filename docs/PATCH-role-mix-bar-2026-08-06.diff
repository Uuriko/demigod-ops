+  /* Role-mix bar. Every segment width is the real share of that function's open roles — nothing
+     here is decorative, because a bar whose width is arbitrary reads as information while being
+     none. Drawn only when there are at least 2 distinct functions and 3+ roles: a single-function
+     company renders one full-width block, which is a shape that says nothing and costs a row of
+     visual noise on 489 directory entries. Inline SVG so it needs no host, cannot 404, and does
+     not add a request — the rest of this site's imagery sits on an anonymous free file host. */
+  var DG_FN_FILL = {
+    'engineering': '#a6ffcb', 'ai/data': '#9fb8a8', 'design': '#f6caca', 'product': '#d6d3cc',
+    'sales': '#e7e5e4', 'marketing': '#f3f0e7', 'operations': '#a8a29e', 'people': '#c8c4bb',
+    'finance/legal': '#b5b0a6',
+  };
+  function dgRoleMixBar(mix) {
+    if (!mix || !mix.length) return '';
+    var total = mix.reduce(function (sum, m) { return sum + m.n; }, 0);
+    if (mix.length < 2 || total < 3) return '';
+    var x = 0;
+    var segs = '';
+    for (var i = 0; i < mix.length; i += 1) {
+      var w = (mix[i].n / total) * 100;
+      segs += '<rect x="' + x.toFixed(2) + '" y="0" width="' + w.toFixed(2) + '" height="6" fill="'
+        + (DG_FN_FILL[mix[i].k] || '#a8a29e') + '"></rect>';
+      x += w;
+    }
+    var label = mix.map(function (m) { return dgFunctionLabel(m.k) + ' ' + m.n; }).join(', ')
+      + ' of ' + total + ' open roles';
+    return '<svg class="dg-dir-mixbar" viewBox="0 0 100 6" preserveAspectRatio="none" role="img" aria-label="'
+      + esc('Role mix: ' + label) + '">' + segs + '</svg>';
+  }
