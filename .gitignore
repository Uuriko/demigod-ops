# === Home-as-repo safety ===
# IMPORTANT: Agent tools (Grok/Cursor) often treat gitignore matches as hard blocks
# and do NOT honor `!` re-include exceptions. Do NOT use broad globs like DEMIGOD-*
# or ignore entire trees that agents must read/edit.

# Agent / tool caches (ok to hard-ignore)
.grok/
.cache/
.npm/
.bun/
.var/
.codex/
.cursor/
.claude/
.claude.json
.claude.json.*
.gemini/
.factory/
.nvm/
.agents/
.commandcode/
.copilot/
.eliza/
node_modules/

# Personal local state — but NOT agent CLIs (those live in ~/bin, not only .local)
.local/
# If something must live under .local/bin for PATH, also keep a copy in bin/

# Most of .config is personal; agent units are installed FROM repo path systemd-user/
.config/

# Shell / OS personal
.bash*
.profile
.viminfo
.DS_Store
*.swp
.ssh/
.gnupg/

# Desktop folders
Downloads/
Pictures/
Desktop/
Documents/
Music/
Videos/
Templates/
Public/
snap/
orca/

# Secrets / local only (narrow — do not use DEMIGOD-* blanket)
HEAVY-*
CURSOR-*
DESK.json
.demigod-ready
audit-shots/
archive/
*.lock
*.env
*secret*
openai*
**/openai.env
**/*api_key*
DEMIGOD-MOBILE-BRIEF.txt

# Logs & temp
*.log
/tmp/
tmp/
.dg-fixture/
# Ad-hoc CDP verification/probe scripts (kept in repo root for ./cdp-config.mjs imports,
# but they are disposable scratch — never commit them).
.dg-*.mjs

# Large / generated
screenshots/
*.mp4
*.webm
playwright-report/
test-results/

# Orca pairing tokens
orca-pair-code.txt
orca-pair-code.html
.keep-awake.pid
keep-awake.log

# 375MB binaries — never commit
orca-linux.AppImage
orca-linux.AppImage.bak.*

# Private Events Bot ops — EVERY DEMIGOD-EVENTS.* file is a full/partial copy of the events SoR
# (offer/RSVP/contact PII). Broad wildcard: the earlier .json.* patterns missed the pre-<label>-<ts>
# snapshots (pre-calpurge/pre-rungate — the suffix is BEFORE .json), which held 12+11 real contact
# emails and were commit-eligible. DEMIGOD-EVENTS.* catches the main file, atomic-write temps
# (.json.tmp.<pid>, .json.bak.<pid>), .corrupt/.archive, AND the pre-* snapshots. Never commit any.
DEMIGOD-EVENTS.json
DEMIGOD-EVENTS.*
events-bot-outbox/
# Leads SoR + its derivatives hold founder/candidate PII -- never commit. Untracked today, so
# ignoring now keeps it out of history cleanly (no scrub needed). The .archive.jsonl is written by
# ingestSubmission's cap (46a1c30); .corrupt.* by loadInbox's preserve-on-corruption guard (665d0da).
DEMIGOD-SUBMISSIONS-INBOX.json
DEMIGOD-SUBMISSIONS-INBOX.json.archive.jsonl
DEMIGOD-SUBMISSIONS-INBOX.json.corrupt.*
# More founder/candidate PII, same rule (untracked today -> ignore now, no scrub). The outreach dir
# holds real contact data + the actual DM drafts + send history; the proof log holds delivery
# testimonials. template-dm.md (no PII) is left trackable on purpose.
demigod-outreach/founders.csv
demigod-outreach/ready-emails/
demigod-outreach/blast-log.json
DEMIGOD-PROOF-LOG.json
DEMIGOD-PROOF-LOG.json.corrupt.*
# Board corruption backups (old .bak/.corrupt snapshots hold real founder handles/emails) and grok
# conversation scratch (contains a personal email). Cruft/scratch, never meant to be committed.
DEMIGOD-BOARD.corrupt*
DEMIGOD-BOARD.CORRUPT*
grok-input.txt
grok-snapshot.txt
grok-tail.txt

# Firecrawl secrets
.env.firecrawl
.firecrawl-key
.config/firecrawl/


# Agent status scratch with a personal email (ORCA pair status).
ORCA-PAIR-EMAIL-STATUS.txt
