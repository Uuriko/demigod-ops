# === Home-as-repo safety ===
# IMPORTANT: Agent tools (Grok/Cursor) often treat gitignore matches as hard blocks
# and do NOT honor `!` re-include exceptions. Do NOT use broad globs like DEMIGOD-*
# or ignore entire trees that agents must read/edit.

# Agent / tool caches (ok to hard-ignore)
.grok/
.cache/
.npm/
.bun/
.var/
.codex/
.cursor/
.claude/
.claude.json
.claude.json.*
.gemini/
.factory/
.nvm/
.agents/
.commandcode/
.copilot/
.eliza/
node_modules/

# Personal local state — but NOT agent CLIs (those live in ~/bin, not only .local)
.local/
# If something must live under .local/bin for PATH, also keep a copy in bin/

# Most of .config is personal; agent units are installed FROM repo path systemd-user/
.config/

# Shell / OS personal
.bash*
.profile
.viminfo
.gitconfig
.zshrc
.wget-hsts
.sudo_as_admin_successful
.DS_Store
*.swp
.ssh/
.gnupg/

# Other local agent/editor/runtime state. This repository is rooted at $HOME, so these are private
# machine configuration, not Demigod source.
.finch/
.fzf/
.hermes/
.kimi-code/
.omp/
.openclaude/
.orca/
.pi/
.pyenv/
.vscode/

# Desktop folders
Downloads/
Pictures/
Desktop/
Documents/
Music/
Videos/
Templates/
Public/
snap/
orca/

# Secrets / local only (narrow — do not use DEMIGOD-* blanket)
HEAVY-*
CURSOR-*
DESK.json
.demigod-ready
audit-shots/
archive/
*.lock
*.env
*secret*
openai*
**/openai.env
**/*api_key*
DEMIGOD-MOBILE-BRIEF.txt

# Logs & temp
*.log
/tmp/
tmp/
.dg-fixture/
# Ad-hoc CDP verification/probe scripts (kept in repo root for ./cdp-config.mjs imports,
# but they are disposable scratch — never commit them).
.dg-*.mjs
.aperture-*.mjs
.check-*.mjs
.dbg-*.mjs
.form-html.mjs
.head-*.mjs
.inspect-*.mjs
.live-*
