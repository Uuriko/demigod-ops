{
  // Set BETA_INVITE_HASH and MODERATOR_TOKEN_HASH with `wrangler secret put`.
  // Never place either value in this file or source control.
  "name": "dasha-receipts",
  "main": "dasha-receipts-worker.mjs",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dasha-receipts",
      "database_id": "REPLACE_AFTER_D1_CREATE"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://REPLACE_WITH_WORKER_OR_RECEIPT_ORIGIN",
    "PUBLIC_ORIGIN": "https://REPLACE_WITH_WORKER_OR_RECEIPT_ORIGIN",
    "BETA_MAX_RECEIPTS": 100
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1000",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "CREATE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "OUTCOME_AUTH_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "OUTCOME_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
