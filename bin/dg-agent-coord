#!/usr/bin/env bash
# NONSTOP multi-agent supervisor: Claude + Codex + Grok CLI workers.
# Lanes (anti-thrash): Claude=website (foot lock), Codex=dash/tools, Grok=gates+blog/light.
# Re-spawns idle workers each tick. Stop: bin/dg-agent-coord stop
set -euo pipefail
ROOT="${DEMIGOD_ROOT:-$HOME}"
BUSY="${DEMIGOD_BUSY:-/tmp/dg-busy}"
DIR="$BUSY/coord"
LOG="$DIR/coord.log"
PIDF="$DIR/coord.pid"
HEARTBEAT="$DIR/coord.heartbeat"
STOP="$DIR/STOP"
BOARD="$DIR/board.json"
CLAUDE_BRIEF="$DIR/CLAUDE-BRIEF.md"
CLAUDE_PIDF="$DIR/claude.pid"
CODEX_PIDF="$DIR/codex.pid"
GROK_PIDF="$DIR/grok.pid"
INBOX="$DIR/inbox.jsonl"
CLAIMS="$DIR/claims.json"
DIGEST="$DIR/digest.md"
mkdir -p "$DIR"
export PATH="${HOME}/.local/bin:${HOME}/bin:${HOME}/.nvm/versions/node/v24.17.0/bin:/usr/bin:/bin:${PATH}"
cd "$ROOT"

# Tunables (sane defaults after thrash review)
COORD_TICK_SEC="${COORD_TICK_SEC:-30}"
COORD_CLAUDE_TIMEOUT="${COORD_CLAUDE_TIMEOUT:-300}"
COORD_CODEX_TIMEOUT="${COORD_CODEX_TIMEOUT:-240}"
COORD_GROK_TIMEOUT="${COORD_GROK_TIMEOUT:-240}"
COORD_LOG_MAX_BYTES="${COORD_LOG_MAX_BYTES:-400000}"

log() { local line="[$(date -Iseconds)] $*"; echo "$line" >>"$LOG"; }

alive() {
  local f="$1"
  [[ -f "$f" ]] || return 1
  local p; p=$(tr -d ' \n' <"$f" || true)
  [[ -n "${p:-}" ]] && kill -0 "$p" 2>/dev/null
}

# Cross-PID-namespace fallback: worker pid files disappear on normal completion.
# Grace defaults to role timeout + 15s (swarm P1) — not a flat 6m that blocks respawn.
worker_active() {
  # $1 pidfile  $2 optional grace_seconds
  local f="$1" grace="${2:-255}"
  alive "$f" && return 0
  [[ -f "$f" ]] || return 1
  local age
  age=$(python3 -c "import os,time; print(int(time.time()-os.path.getmtime('$f')))" 2>/dev/null || echo 99999)
  [[ "$age" -le "$grace" ]]
}

heartbeat_fresh() { [[ -n "$(find "$HEARTBEAT" -mmin -2 -print -quit 2>/dev/null)" ]]; }

rotate_log() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  local sz
  sz=$(wc -c <"$f" 2>/dev/null || echo 0)
  if (( sz > COORD_LOG_MAX_BYTES )); then
    tail -c "$((COORD_LOG_MAX_BYTES/2))" "$f" | sed '1d' >"$f.tmp" && mv "$f.tmp" "$f"
    log "rotated $(basename "$f") was ${sz}b"
  fi
}

# Digest last receipts → CLAUDE-BRIEF + digest.md (shared truth for all agents)
refresh_digest() {
  flock -x "$DIR/digest.lock" env DG_COORD_DIR="$DIR" DG_ROOT="$ROOT" python3 - <<'PY'
import datetime, fcntl, json, os
from pathlib import Path
DIR = Path(os.environ["DG_COORD_DIR"])
ROOT = Path(os.environ["DG_ROOT"])
DIR.mkdir(parents=True, exist_ok=True)
now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def atomic_write(path, text):
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text)
    tmp.replace(path)

def load(name):
    p = DIR / name
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text())
    except Exception:
        return {"ok": False, "at": None, "did": ["(unparseable)"], "raw_error": True}

agents = {
    "claude": load("claude-last.json"),
    "codex": load("codex-last.json"),
    "grok": load("grok-last.json"),
    "chat": load("chat-last.json"),
    "term-claude": load("term-claude-last.json"),
    "term-grok": load("term-grok-last.json"),
}

def current_receipt(receipt):
    if not receipt or not receipt.get("at"):
        return False
    try:
        stamp = datetime.datetime.fromisoformat(str(receipt["at"]).replace("Z", "+00:00"))
        age = (datetime.datetime.now(datetime.timezone.utc) - stamp).total_seconds()
        return -60 <= age <= 3600
    except Exception:
        return False

# foot ver from disk
foot_ver = "?"
try:
    import re
    t = (ROOT / "demigod-foot-core.js").read_text(errors="replace")
    m = re.search(r"__dgFootVer=['\"](\d+)['\"]", t)
    if m:
        foot_ver = "v" + m.group(1)
except Exception:
    pass

# claims — expire holds older than 15m so digest never advertises dead locks as active
claims = {}
cp = DIR / "claims.json"
with (DIR / "claims.lock").open("w") as claims_lock:
    fcntl.flock(claims_lock, fcntl.LOCK_EX)
    if cp.exists():
        try:
            claims = json.loads(cp.read_text())
        except Exception:
            claims = {}
    holds = claims.get("holds") if isinstance(claims.get("holds"), dict) else {}
    def stale(value):
        stamp = value.get("at") if isinstance(value, dict) else claims.get("at")
        try:
            age = (datetime.datetime.now(datetime.timezone.utc) - datetime.datetime.fromisoformat(str(stamp).replace("Z", "+00:00"))).total_seconds() * 1000
        except Exception:
            return True
        return age < -60_000 or age > 15 * 60 * 1000
    cleared = [key for key, value in holds.items() if stale(value)]
    holds_stale = bool(cleared)
    if cleared:
        holds = {key: value for key, value in holds.items() if key not in cleared}
        claims.update({"holds": holds, "at": now, "holdsCleared": cleared, "holdsStale": True})
        atomic_write(cp, json.dumps(claims, indent=2) + "\n")
active_holds = holds  # empty when stale/cleared

# Keep the board's receipt view current even when no supervisor worker needs spawning.
bp = DIR / "board.json"
with (DIR / "board.lock").open("w") as board_lock:
    fcntl.flock(board_lock, fcntl.LOCK_EX)
    try:
        board = json.loads(bp.read_text()) if bp.exists() else {}
    except Exception:
        board = {}
    receipts = {name: d["at"] for name, d in agents.items() if current_receipt(d)}
    changed = board.get("receipts") != receipts
    if changed:
        board["receipts"] = receipts
        board["receiptsAt"] = max(receipts.values(), default=None)
    tracks = board.setdefault("tracks", {})
    for lane, names in {"claude": ("claude", "term-claude"), "codex": ("codex",), "grok": ("grok", "term-grok")}.items():
        latest = max((agents[name] for name in names if current_receipt(agents.get(name))), key=lambda d: d["at"], default=None)
        if latest and tracks.get(lane, {}).get("at") != latest["at"]:
            tracks[lane] = {"status": "idle", "last": "receipt ok" if latest.get("ok") else "receipt failed", "at": latest["at"]}
            changed = True
    try:
        facts = json.loads((DIR.parent / "ship-status.json").read_text()).get("facts") or {}
        versions = {str(facts.get(key) or "").lstrip("v") for key in ("diskVer", "liveVer", "manVer")}
        if len(versions) == 1 and "" not in versions:
            backlog = [x for x in board.get("backlog", []) if not ("hold head" in str(x).lower() and "thrash" in str(x).lower())]
            if backlog != board.get("backlog", []):
                board["backlog"] = backlog
                changed = True
    except Exception:
        pass
    if changed:
        atomic_write(bp, json.dumps(board, indent=2) + "\n")

lines = [
    f"# Coord digest (auto) · {now}",
    "",
    f"**Disk foot:** {foot_ver} · ship only with `bin/dg-lock` + foot lock · no auto-DM · no game",
    "",
    "## Lanes (stay in lane; claims serialize access, never grant authority)",
    "- **claude** → website SoR only: `demigod-foot-core.js`, `demigod-head-minimal.html`, `demigod-blog-posts.json` — always `DG_LOCK_OWNER=coord-claude bin/dg-lock …` for foot",
    "- **codex** → dash/tools only: `demigod-agent-dashboard*`, webflow helpers, verify tooling — **never** edit foot-core",
    "- **grok** → gates + light blog/head + coord hygiene; foot only if claim free via dg-lock; prefer verify + /api/coord dogfood",
    "- **chat/term** → read digest; pick ONE backlog item; skip if claim held by another agent",
    "",
    "## Recent did (read before working — do not redo)",
]
for name, d in agents.items():
    if not d:
        lines.append(f"- **{name}**: (no receipt)")
        continue
    did = d.get("did") or []
    if isinstance(did, str):
        did = [did]
    did_s = "; ".join(str(x)[:120] for x in did[:3]) or "(empty)"
    at = d.get("at") or "?"
    ok = d.get("ok")
    nxt = str(d.get("next") or "")[:100]
    try:
        age = (datetime.datetime.now(datetime.timezone.utc) - datetime.datetime.fromisoformat(str(at).replace("Z", "+00:00"))).total_seconds()
        note = " [stale]" if age < -60 or age > 3600 else ""
    except Exception:
        note = " [stale]"
    if d.get("staleSuccessAvoided"):
        note += " [staleSuccessAvoided]"
    lines.append(f"- **{name}** ok={ok} at={at}{note}: {did_s}")
    if nxt:
        lines.append(f"  - next: {nxt}")

lines += ["", "## Active claims"]
if active_holds:
    for k, v in active_holds.items():
        if isinstance(v, dict):
            owner = v.get("owner")
        else:
            owner = v
        lines.append(f"- {k}: {owner}")
elif holds_stale:
    lines.append(f"- (stale holds cleared: {', '.join(claims.get('holdsCleared') or [])}; not active)")
else:
    lines.append("- (none recorded in claims.json)")
# Codex swarm assist (regular timer: bin/dg-codex-swarm)
try:
    sp = (DIR.parent / "swarm" / "swarm-last.json")
    swarm_last = json.loads(sp.read_text()) if sp.exists() else None
except Exception:
    swarm_last = None
lines += ["", f"## Codex swarm (read {DIR.parent / 'swarm' / 'latest.md'})"]
if swarm_last:
    lines.append(f"- last ok={swarm_last.get('ok')} at={swarm_last.get('at')} mode={swarm_last.get('mode')}")
    lines.append(f"- note: {str(swarm_last.get('note') or '')[:160]}")
    lines.append("- implement top P0 from latest.md in your lane before inventing new thrash")
else:
    lines.append("- (no swarm-last yet — `bin/dg-codex-swarm once` or timer demigod-codex-swarm.timer)")

# Workflow diagram auto-refresh
wm = None
try:
    wp = (DIR / "workflow-map-last.json")
    wm = json.loads(wp.read_text()) if wp.exists() else None
except Exception:
    wm = None

# Anti-bloat / north star (all agents)
ab = None
try:
    ap = (DIR / "anti-bloat-last.json")
    ab = json.loads(ap.read_text()) if ap.exists() else None
except Exception:
    ab = None
lines += ["", "## North star + anti-bloat (all agents)"]
lines.append("- **Product first:** best website + Demigod matching UX/honesty/ship — not more orchestration.")
lines.append("- **Create & delete:** new pages/copy/forms OK; remove bad copy, dead code, wrong features when right.")
lines.append("- Catalog: `docs/DEMIGOD-ANTI-BLOAT-SEARCHES.md` · pick: `bin/dg-anti-bloat pick` · doctrine: `bin/dg-anti-bloat doctrine`")
lines.append("- Prefer 1 solid foot/head/blog/WIZ win over 3 meta-tool wins. Cut timers/planes that do not serve product.")
lines.append("- **Ship cadence:** if disk foot ≫ live/manifest, run `bin/dg ship prepare|run|verify` — do not hoard unshipped site work. Full product scope (blog, SEO, WIZ, copy).")
if ab:
    lines.append(f"- Last research {ab.get('id') or ab.get('pick') or '?'} at={ab.get('at')}: {str((ab.get('bullets') or [ab.get('did') or ''])[0])[:140]}")
    if ab.get("apply"):
        lines.append(f"- Apply: {str(ab.get('apply'))[:160]}")


# Quality loop (audits / bugfix / sim-user)
ql = None
qb = None
try:
    ql = json.loads((DIR / "quality-last.json").read_text()) if (DIR / "quality-last.json").exists() else None
    qb = json.loads((DIR / "quality-backlog.json").read_text()) if (DIR / "quality-backlog.json").exists() else None
except Exception:
    pass

# Ops / autonomy OS
ops = None
try:
    ops = json.loads((DIR.parent / "ops-os.json").read_text()) if (DIR.parent / "ops-os.json").exists() else None
except Exception:
    pass
lines += ["", "## Ops OS (full Demigod loop → paid placement)"]
lines.append("- Spine: demand→submit→triage→match→mutual yes→intro→hire→invoice→paid · `bin/dg-ops-os status|next|roadmap`")
lines.append("- Roadmap: `docs/DEMIGOD-AUTONOMY-OS-ROADMAP.md` · Stripe PENDING until keys (tomorrow)")
if ops:
    lines.append(f"- autonomy≈{ops.get('autonomyScore',{}).get('score')} · founders_in={ops.get('funnel',{}).get('startupSubmissions')} talent_in={ops.get('funnel',{}).get('talentSubmissions')} pairs={ops.get('funnel',{}).get('matchPairs')} shipped={ops.get('funnel',{}).get('shipShipped')}")
    nxt = (ops.get("next") or [{}])[0]
    if nxt:
        lines.append(f"- Top next: P{nxt.get('pri')} {str(nxt.get('action',''))[:120]}")

lines += ["", "## Quality loop (audits · bugfix · reviews — before more features)"]
lines.append("- Catalog: `docs/DEMIGOD-QUALITY-LOOP.md` · `bin/dg-quality once|status|backlog|doctrine`")
lines.append("- **If quality-backlog has open P0/P1, fix those before inventing new product surface.**")
if ql:
    lines.append(f"- Last wave: {ql.get('id')} {ql.get('name')} ok={ql.get('ok')} at={ql.get('at')} findings={len(ql.get('findings') or [])}")
if qb:
    lines.append(f"- Backlog open: {qb.get('open', 0)} (read quality-backlog.json)")
lines.append("- Timer: demigod-quality-loop.timer every 3h · also run after ship")

lines += ["", "## Workflow map (Map tab → Agents / /api/maps/agents)"]
if wm:
    map_foot = str(wm.get("foot") or "?")
    version_note = " [stale version]" if map_foot != foot_ver else ""
    lines.append(f"- last {wm.get('mode')} ok={wm.get('ok')} at={wm.get('at')} foot={map_foot}{version_note} cycle={wm.get('cycle')}")
    probs = wm.get("problems") or []
    if probs:
        lines.append(f"- review problems: {'; '.join(str(p)[:80] for p in probs[:3])}")
    lines.append("- refresh: `bin/dg-workflow-map update` (timer every 2h + after codex swarm)")
else:
    lines.append("- (no workflow-map-last yet — `bin/dg-workflow-map update`)")

lines += [
    "",
    "## Shared rules",
    "1. Read this digest + board.json + peer *-last.json before edits.",
    "2. One concrete win per cycle; Ponytail; verify:source if foot/head.",
    "3. Write your *-last.json with {ok,at,did[],next,files[],lane}.",
    f"4. Stay in lane. Claims only serialize hot files: `bin/dg-agent-coord claim <role> <path>` before edit; `release-hold <role> <path>` when done (foot still uses bin/dg-lock).",
    "5. No thrash publish/CDN; intentional ship only.",
    "",
]
atomic_write(DIR / "digest.md", "\n".join(lines) + "\n")

# Brief = short static + pointer to digest
brief = f"""# Demigod multi-agent brief (Claude + Grok + Codex)

**North star:** best **website + Demigod product** (honesty, WIZ, matching UX, ship). Orchestration is scaffolding — cut what does not serve product.
**Goal:** improve site + tools continuously — **lanes, no thrash**. Prefer 1 solid site win over 3 meta-tools.
**Anti-bloat:** `docs/DEMIGOD-ANTI-BLOAT-SEARCHES.md` · `bin/dg-anti-bloat doctrine|pick|log`
**Ship cadence:** disk ≫ live → `bin/dg ship prepare|run|verify`. Full product scope (blog/SEO/WIZ/copy).
**Quality loop:** after feature batches run `bin/dg-quality once` — fix P0/P1 before more features. `docs/DEMIGOD-QUALITY-LOOP.md`
**Ops OS:** full funnel autonomy map `bin/dg-ops-os status|next` · roadmap `docs/DEMIGOD-AUTONOMY-OS-ROADMAP.md` · Stripe pending
**Live:** foot disk may be ahead of live; `bin/dg truth`; ship only with lock. No auto-DM. No game.
**SoR:** demigod-foot-core.js · demigod-head-minimal.html · demigod-blog-posts.json
**Dash:** http://127.0.0.1:9878/ · GET /api/coord · Map→Agents · bin/dg
**CDP:** :9223 · verify: npm run demigod:verify:source
**Coord:** {DIR}/ — write your *-last.json; read **digest.md** every cycle
**Dogfood:** GET /api/coord → diskReady + footNotes + head/footerLite shipReady
**Foot disk now:** {foot_ver}

## Lanes
| Agent | Owns | Forbidden |
|-------|------|-----------|
| claude | foot/head/blog (via bin/dg-lock) | dash thrash, auto-DM |
| codex | dash/tools/webflow helpers | demigod-foot-core.js |
| grok | verify, coord, light head/blog | concurrent foot without lock |

**Full digest (auto-refreshed):** `{DIR / 'digest.md'}`
"""
atomic_write(DIR / "CLAUDE-BRIEF.md", brief)
print(f"digest ok foot={foot_ver}")
PY
}

init_board() {
  flock -x "$DIR/board.lock" env BOARD="$BOARD" python3 - <<'PY'
import json, os
from pathlib import Path
p = Path(os.environ["BOARD"])
b = json.loads(p.read_text()) if p.exists() else {}
b.setdefault("schema", "demigod.agent-coord/2")
b.setdefault("cycle", 0)
b.setdefault("goal", "nonstop website+tools · lanes")
tmp = p.with_name(f".{p.name}.{os.getpid()}.tmp")
tmp.write_text(json.dumps(b, indent=2) + "\n")
tmp.replace(p)
PY
  [[ -f "$CLAIMS" ]] || printf '%s\n' '{"schema":"demigod.coord-claims/1","holds":{}}' >"$CLAIMS"
}

cycle_num() {
  python3 - "$BOARD" <<'PY'
import json
import sys
from pathlib import Path
p=Path(sys.argv[1])
b=json.loads(p.read_text()) if p.exists() else {"cycle":0}
print(int(b.get("cycle") or 0))
PY
}

bump_cycle() {
  # Refresh release backlog from ship/truth so versioned seal text cannot rot (swarm P1).
  flock -x "$DIR/board.lock" python3 - "$BOARD" "$ROOT" <<'PY'
import json, datetime, os, re
import sys
from pathlib import Path
p=Path(sys.argv[1])
root=Path(sys.argv[2])
b=json.loads(p.read_text()) if p.exists() else {}
b["schema"]="demigod.agent-coord/2"
b["cycle"]=int(b.get("cycle") or 0)+1
b["at"]=datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
b["goal"]="nonstop website+tools · lanes Claude/Codex/Grok"
tracks=b.setdefault("tracks", {})
tracks.setdefault("website", {"status":"active","owner":"claude","focus":"foot/head/blog via dg-lock"})
tracks.setdefault("dash_tools", {"status":"active","owner":"codex","focus":"dashboard + webflow tools only"})
tracks.setdefault("gates", {"status":"active","owner":"grok","focus":"verify + coord hygiene"})

def ship_facts():
    busy = DIR.parent
    try:
        hit = re.search(r"__dgFootVer=['\"](\d+)['\"]", (root / "demigod-foot-core.js").read_text(errors="replace"))
        canonical = hit.group(1) if hit else None
    except Exception:
        canonical = None
    try:
        s = json.loads((busy / "ship-status.json").read_text())
        f = s.get("facts") or {}
        d = str(f.get("diskVer") or "").lstrip("v")
        l = str(f.get("liveVer") or "").lstrip("v")
        m = str(f.get("manVer") or "").lstrip("v")
        if d and (not canonical or d == canonical):
            return d, l, m
    except Exception:
        pass
    try:
        s = json.loads((busy / "truth.json").read_text())
        d = str((s.get("foot") or {}).get("ver") or "").lstrip("v")
        l = str((s.get("live") or {}).get("footVer") or "").lstrip("v")
        m = str((s.get("manifest") or {}).get("version") or "").lstrip("v")
        if d and (not canonical or d == canonical):
            return d, l, m
    except Exception:
        pass
    return None, None, None

d, l, m = ship_facts()
if d:
    seal = f"After lock free + Webflow re-auth: CM6 paste seals live to disk/man v{d}"
    if l and l != d:
        seal += f" (live now v{l})"
    hold = "Hold head 8s6x5e; no thrash while login wall"
    keep = []
    for x in (b.get("backlog") or []):
        xl = str(x).lower()
        if any(k in xl for k in ("cm6 paste", "seals live", "disk/man v", "paste seals")):
            continue
        if "hold head" in xl and "thrash" in xl:
            continue
        keep.append(str(x))
    bl = []
    if (l and l != d) or (m and m != d):
        bl.append(seal)
        bl.append(hold)
    bl.extend(keep)
    b["backlog"] = bl
    # Stale ship version must not survive when truth disk is known (e.g. v531 vs v562)
    for line in bl:
        for hit in re.findall(r"(?:disk/man|seals live(?: to disk/man)?)\s+v(\d+)", line, re.I):
            if hit != d:
                raise SystemExit(f"stale backlog ship version v{hit} != disk v{d}")

tmp=p.with_name(f".{p.name}.{os.getpid()}.tmp")
tmp.write_text(json.dumps(b, indent=2)+"\n")
tmp.replace(p)
print(b["cycle"])
PY
}

set_track() {
  # $1 agent $2 status $3 last note
  flock -x "$DIR/board.lock" python3 - "$BOARD" "$1" "$2" "$3" <<'PY'
import json, datetime, os
import sys
from pathlib import Path
p=Path(sys.argv[1])
b=json.loads(p.read_text()) if p.exists() else {}
t=b.setdefault("tracks", {})
ag=sys.argv[2]
next_track={"status":sys.argv[3],"last":sys.argv[4][:200]}
if all(t.get(ag, {}).get(k) == v for k, v in next_track.items()):
    raise SystemExit
t[ag]={**next_track,"at":datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
tmp=p.with_name(f".{p.name}.{os.getpid()}.tmp")
tmp.write_text(json.dumps(b, indent=2)+"\n")
tmp.replace(p)
PY
}

reconcile_dead_supervisor() {
  [[ ! -f "$STOP" ]] && ! alive "$PIDF" && ! heartbeat_fresh || return 0
  rm -f "$PIDF"
  for role in claude codex grok; do
    alive "$DIR/$role.pid" || { rm -f "$DIR/$role.pid"; release_owner_claims "coord-$role"; set_track "$role" idle "interrupted: supervisor not running"; }
  done
}

release_owner_claims() {
  # $1 owner — completed workers must not leave advisory claims blocking peers
  flock -x "$DIR/claims.lock" python3 - "$1" "$CLAIMS" <<'PY'
import datetime, json, os, sys
from pathlib import Path
p = Path(sys.argv[2])
if not p.exists():
    raise SystemExit
c = json.loads(p.read_text())
holds = c.get("holds") if isinstance(c.get("holds"), dict) else {}
def hold_owner(v):
    # Legacy string owners + timestamped object owners share one equality path.
    if isinstance(v, dict):
        return v.get("owner")
    return v
owners = {sys.argv[1], sys.argv[1].removeprefix("coord-")}
c["holds"] = {k: v for k, v in holds.items() if hold_owner(v) not in owners}
if len(c["holds"]) != len(holds):
    c["at"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    tmp = p.with_name(f".{p.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(c, indent=2) + "\n")
    tmp.replace(p)
PY
}

# Atomic advisory claims (swarm P0) — does not replace bin/dg-lock for foot-core.
claim_hold() {
  # $1 role  $2 key (path or resource id)
  local role="${1:-}" key="${2:-}"
  [[ -n "$role" && -n "$key" ]] || { echo "usage: $0 claim <role> <key>" >&2; return 2; }
  flock -x "$DIR/claims.lock" python3 - "$role" "$key" "$CLAIMS" "$ROOT" <<'PY'
import datetime, json, os, sys
from pathlib import Path
role, key, path, root = sys.argv[1], sys.argv[2], Path(sys.argv[3]), Path(sys.argv[4])
owner = f"coord-{role}" if not str(role).startswith("coord-") else str(role)
lane = role.removeprefix("coord-")
try:
    claimed_path = Path(key) if Path(key).is_absolute() else root / key
    relative = claimed_path.resolve().relative_to(root.resolve()).as_posix()
except (OSError, ValueError):
    relative = key
key = relative
if lane == "codex" and relative in {"demigod-foot-core.js", "demigod-head-minimal.html", "demigod-blog-posts.json"}:
    print(json.dumps({"ok": False, "error": "lane_violation", "lane": lane, "key": key}))
    raise SystemExit(1)
now = datetime.datetime.now(datetime.timezone.utc)
now_s = now.strftime("%Y-%m-%dT%H:%M:%SZ")
if path.exists():
    try:
        c = json.loads(path.read_text())
    except Exception:
        c = {"schema": "demigod.coord-claims/1", "holds": {}}
else:
    c = {"schema": "demigod.coord-claims/1", "holds": {}}
holds = c.get("holds") if isinstance(c.get("holds"), dict) else {}
cur = holds.get(key)
def hold_owner(v):
    return v.get("owner") if isinstance(v, dict) else v
def hold_at(v, fallback=None):
    if isinstance(v, dict) and v.get("at"):
        return v.get("at")
    return fallback or c.get("at")
if cur is not None:
    o = hold_owner(cur)
    aliases = {owner, owner.removeprefix("coord-"), role, f"coord-{role}"}
    if o not in aliases:
        try:
            age = (now - datetime.datetime.fromisoformat(str(hold_at(cur)).replace("Z", "+00:00"))).total_seconds()
        except Exception:
            age = 99999
        if age <= 15 * 60:
            print(json.dumps({"ok": False, "error": "held", "key": key, "owner": o, "at": hold_at(cur)}))
            raise SystemExit(1)
holds[key] = {"owner": owner, "at": now_s, "lane": lane}
c["holds"] = holds
c["at"] = now_s
c["schema"] = c.get("schema") or "demigod.coord-claims/1"
tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
tmp.write_text(json.dumps(c, indent=2) + "\n")
tmp.replace(path)
print(json.dumps({"ok": True, "claimed": holds[key], "key": key}))
PY
}

release_hold() {
  # $1 role  $2 key
  local role="${1:-}" key="${2:-}"
  [[ -n "$role" && -n "$key" ]] || { echo "usage: $0 release-hold <role> <key>" >&2; return 2; }
  flock -x "$DIR/claims.lock" python3 - "$role" "$key" "$CLAIMS" "$ROOT" <<'PY'
import datetime, json, os, sys
from pathlib import Path
role, key, path, root = sys.argv[1], sys.argv[2], Path(sys.argv[3]), Path(sys.argv[4])
try:
    key = (Path(key) if Path(key).is_absolute() else root / key).resolve().relative_to(root.resolve()).as_posix()
except (OSError, ValueError):
    pass
if not path.exists():
    print(json.dumps({"ok": True, "released": False, "reason": "missing"}))
    raise SystemExit(0)
c = json.loads(path.read_text())
holds = c.get("holds") if isinstance(c.get("holds"), dict) else {}
cur = holds.get(key)
if cur is None:
    print(json.dumps({"ok": True, "released": False, "reason": "absent"}))
    raise SystemExit(0)
owner = f"coord-{role}" if not str(role).startswith("coord-") else str(role)
aliases = {owner, owner.removeprefix("coord-"), role, f"coord-{role}"}
o = cur.get("owner") if isinstance(cur, dict) else cur
if o not in aliases:
    print(json.dumps({"ok": False, "error": "not_owner", "owner": o, "key": key}))
    raise SystemExit(1)
del holds[key]
c["holds"] = holds
c["at"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
tmp.write_text(json.dumps(c, indent=2) + "\n")
tmp.replace(path)
print(json.dumps({"ok": True, "released": True, "key": key}))
PY
}

list_claims() {
  python3 - "$CLAIMS" <<'PY'
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
if not p.exists():
    print(json.dumps({"schema":"demigod.coord-claims/1","holds":{}}))
    raise SystemExit(0)
print(p.read_text())
PY
}

# Swarm P1: do not respawn idle roles when there is no actionable work (once forces).
# Tightened: ship/CSS lag alone must NOT keep all three lanes forever-busy (swarm full P1).
role_has_work() {
  local role="$1"
  python3 - "$role" "$DIR/quality-backlog.json" "$BOARD" "$CLAIMS" "$BUSY" <<'PY'
import json, sys, time
from pathlib import Path
role = sys.argv[1]
qpath, bpath, cpath, busy = Path(sys.argv[2]), Path(sys.argv[3]), Path(sys.argv[4]), Path(sys.argv[5])

def ship_lag():
    try:
        s = json.loads((busy / "ship-status.json").read_text())
        f = s.get("facts") or {}
        d = str(f.get("diskVer") or "").replace("v", "")
        l = str(f.get("liveVer") or "").replace("v", "")
        m = str(f.get("manVer") or "").replace("v", "")
        return bool(d and ((l and d != l) or (m and d != m)))
    except Exception:
        return False

# open P0/P1 only for matching lane (or unassigned)
try:
    q = json.loads(qpath.read_text()) if qpath.exists() else {}
    for it in q.get("items") or []:
        if it.get("status") != "open" or it.get("sev") not in ("P0", "P1"):
            continue
        lane = (it.get("lane") or "").lower()
        if not lane or lane in (role, "any", "all"):
            print("1"); raise SystemExit(0)
        if role == "claude" and lane in ("website", "site"):
            print("1"); raise SystemExit(0)
        if role == "codex" and lane in ("tools", "dash", "dashboard", "webflow"):
            print("1"); raise SystemExit(0)
        if role == "grok" and lane in ("gates", "verify", "coord"):
            print("1"); raise SystemExit(0)
except Exception:
    pass

# Backlog: only lane-specific *new product* work — ignore pure ship/css thrash notes
try:
    b = json.loads(bpath.read_text()) if bpath.exists() else {}
    bl = [str(x) for x in (b.get("backlog") or [])]
    text = " ".join(bl).lower()
    shipish = any(k in text for k in ("css lag", "catbox", "paste", "cdn", "live v", "disk≠", "disk!="))
    if role == "claude":
        # website source work only if backlog names product gaps, not delivery lag
        product = any(k in text for k in ("designer", "wiz", "notes card", "blog post", "seo copy", "unhide", "a11y", "form "))
        if product and not (shipish and not product):
            print("1"); raise SystemExit(0)
        if any(k in text for k in ("wiz", "blog post", "notes card")):
            print("1"); raise SystemExit(0)
    if role == "codex":
        if any(k in text for k in ("dashboard", "dash bug", "webflow helper", "cm6", "claim", "coord claim", "tools-os")):
            print("1"); raise SystemExit(0)
    if role == "grok":
        if any(k in text for k in ("loop-state", "board honesty", "verify fail", "gate fail")):
            print("1"); raise SystemExit(0)
except Exception:
    pass

# Ship lag: Codex owns Webflow paste tooling only (not Claude thrash, not endless Grok waves)
if ship_lag() and role == "codex":
    print("1"); raise SystemExit(0)
# Grok dogfood ship lag at most every 12 minutes (receipt age)
if ship_lag() and role == "grok":
    try:
        rec = json.loads((busy / "coord/grok-last.json").read_text())
        age = time.time() - __import__("datetime").datetime.fromisoformat(
            str(rec.get("at", "")).replace("Z", "+00:00")
        ).timestamp()
        if age > 12 * 60:
            print("1"); raise SystemExit(0)
    except Exception:
        print("1"); raise SystemExit(0)

print("0")
PY
}

inbox() {
  flock -x 9
  rotate_log "$INBOX"
  printf '{"at":"%s","from":"%s","msg":%s}\n' "$(date -Iseconds)" "$1" "$(python3 -c 'import json,sys;print(json.dumps(sys.argv[1]))' "$2")" >>"$INBOX"
} 9>"$DIR/inbox.lock"

write_exit_receipt() {
  # $1 path $2 exit $3 logpath $4 lane $5 pre_mtime_ns (0 if none)
  # Preserve prior ok:true ONLY if agent rewrote the receipt during this run (mtime advanced).
  # Stops timeouts from advertising stale success (swarm P1).
  python3 - <<PY
import json, datetime, pathlib, os
p=pathlib.Path("$1")
log=pathlib.Path("$3")
lane="$4"
pre_ns=int("${5:-0}" or "0")
ec=int("$2")
tail=log.read_text(errors="replace")[-2500:] if log.exists() else ""
try:
  prev=json.loads(p.read_text())
except Exception:
  prev=None
post_ns=0
try:
  post_ns=p.stat().st_mtime_ns
except Exception:
  pass
# Agent wrote during this run if mtime advanced past pre-spawn snapshot
fresh_write = isinstance(prev, dict) and post_ns > pre_ns
if fresh_write:
  prev.setdefault("lane", lane)
  if ec != 0:
    prev["workerVerdict"] = prev.get("ok")
    prev["ok"] = False
  prev["exit"]=ec
  prev["supervisorNote"]=f"process exit {ec}; {'overrode' if ec else 'kept'} agent receipt verdict (mtime advanced this run)"
  if "at" not in prev:
    prev["at"]=datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
else:
  # No fresh agent receipt means no run-scoped success evidence, regardless of exit code.
  prev = {
    "at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "exit": ec,
    "ok": False,
    "lane": lane,
    "did": [],
    "staleSuccessAvoided": bool(isinstance(prev, dict) and prev.get("ok") is True),
    "tail": tail[-1500:] if ec != 0 else "",
  }
tmp=p.with_name(f".{p.name}.{os.getpid()}.tmp")
tmp.write_text(json.dumps(prev, indent=2)+"\n")
tmp.replace(p)
PY
}

receipt_mtime_ns() {
  # $1 path → mtime ns or 0
  python3 -c "import pathlib;p=pathlib.Path('$1');print(p.stat().st_mtime_ns if p.exists() else 0)" 2>/dev/null || echo 0
}

# Backoff after timeout(124)/fail — file mtime = next-allowed spawn
backoff_active() {
  local f="$DIR/${1}.backoff"
  [[ -f "$f" ]] || return 1
  local until now
  until=$(tr -d ' \n' <"$f" 2>/dev/null || echo 0)
  now=$(date +%s)
  (( now < until ))
}
set_backoff() {
  # $1 role $2 seconds
  echo $(( $(date +%s) + ${2:-60} )) >"$DIR/${1}.backoff"
}

# Spawn helpers: optional cycle id $1 (shared tick). If empty, bump for this spawn only.
spawn_claude() {
  local spawn_fd; exec {spawn_fd}>"$DIR/claude-spawn.lock"
  flock -n "$spawn_fd" || return 0
  worker_active "$CLAUDE_PIDF" && return 0
  if backoff_active claude; then return 0; fi
  rotate_log "$DIR/claude-run.log"
  local c="${1:-}"
  [[ -n "$c" ]] || c=$(bump_cycle)
  local logf="$DIR/claude-run.log"
  local pre; pre=$(receipt_mtime_ns "$DIR/claude-last.json")
  refresh_digest
  set_track claude busy "spawn c=$c website lane"
  log "spawn claude c=$c lane=website"
  inbox supervisor "spawn claude c=$c lane=website"
  (
    set +e
    timeout "$COORD_CLAUDE_TIMEOUT" stdbuf -oL -eL claude -p \
"Demigod NONSTOP cycle $c · LANE=website (foot/head/blog only).
READ digest.md + /tmp/dg-busy/swarm/latest.md first (peer receipts only if digest flags conflict).
Before editing any hot file: bin/dg-agent-coord claim claude <path> (fail=skip that file). Foot: DG_LOCK_OWNER=coord-claude bin/dg-lock …
NORTH STAR: website product first. 1-2 Ponytail site wins. verify:source if foot/head edited.
FORBIDDEN: demigod-agent-dashboard*. No auto-DM/game/thrash publish.
Write claude-last.json {ok,at,did[],next,files[],claims[],lane:\"website\",cycle:$c}." \
      --dangerously-skip-permissions --permission-mode bypassPermissions \
      --model "${COORD_CLAUDE_MODEL:-sonnet}" --add-dir "$ROOT" \
      >>"$logf" 2>&1
    ec=$?
    write_exit_receipt "$DIR/claude-last.json" "$ec" "$logf" website "$pre"
    release_owner_claims coord-claude
    set_track claude idle "done ec=$ec"
    if (( ec == 124 || ec != 0 )); then set_backoff claude 90; log "claude backoff 90s after ec=$ec"; fi
    rm -f "$CLAUDE_PIDF"
    log "claude done ec=$ec"
    refresh_digest
  ) &
  echo $! >"$CLAUDE_PIDF"
}

spawn_codex() {
  local spawn_fd; exec {spawn_fd}>"$DIR/codex-spawn.lock"
  flock -n "$spawn_fd" || return 0
  worker_active "$CODEX_PIDF" && return 0
  if backoff_active codex; then return 0; fi
  rotate_log "$DIR/codex-run.log"
  local c="${1:-}"
  [[ -n "$c" ]] || c=$(bump_cycle)
  local logf="$DIR/codex-run.log"
  local pre; pre=$(receipt_mtime_ns "$DIR/codex-last.json")
  refresh_digest
  set_track codex busy "spawn c=$c tools lane"
  log "spawn codex c=$c lane=tools"
  inbox supervisor "spawn codex c=$c lane=tools"
  (
    set +e
    timeout "$COORD_CODEX_TIMEOUT" stdbuf -oL -eL codex exec --full-auto --sandbox workspace-write \
"Demigod NONSTOP cycle $c · LANE=tools (dash/webflow only).
READ digest.md + /tmp/dg-busy/swarm/latest.md first.
Before edit: bin/dg-agent-coord claim codex <path>. Prefer Webflow paste/doctor/ship tooling + dash light path.
NORTH STAR: product first. 1-2 Ponytail tools/Webflow wins. FORBIDDEN: demigod-foot-core.js.
Write codex-last.json {ok,at,did,files,claims[],verification,lane:\"tools\",cycle:$c}. No auto-DM/game." \
      >>"$logf" 2>&1
    ec=$?
    write_exit_receipt "$DIR/codex-last.json" "$ec" "$logf" tools "$pre"
    release_owner_claims coord-codex
    set_track codex idle "done ec=$ec"
    if (( ec == 124 || ec != 0 )); then set_backoff codex 60; log "codex backoff 60s after ec=$ec"; fi
    rm -f "$CODEX_PIDF"
    log "codex done ec=$ec"
    refresh_digest
  ) &
  echo $! >"$CODEX_PIDF"
}

spawn_grok() {
  local spawn_fd; exec {spawn_fd}>"$DIR/grok-spawn.lock"
  flock -n "$spawn_fd" || return 0
  worker_active "$GROK_PIDF" && return 0
  if backoff_active grok; then return 0; fi
  command -v grok >/dev/null 2>&1 || { log "grok CLI missing"; return 0; }
  rotate_log "$DIR/grok-run.log"
  local c="${1:-}"
  [[ -n "$c" ]] || c=$(bump_cycle)
  local logf="$DIR/grok-run.log"
  local pre; pre=$(receipt_mtime_ns "$DIR/grok-last.json")
  refresh_digest
  set_track grok busy "spawn c=$c gates lane"
  log "spawn grok c=$c lane=gates"
  inbox supervisor "spawn grok c=$c lane=gates"
  (
    set +e
    timeout "$COORD_GROK_TIMEOUT" stdbuf -oL -eL grok -p \
"Demigod NONSTOP Grok cycle $c · LANE=gates+coord.
READ digest.md + /tmp/dg-busy/swarm/latest.md first.
Before hot-file edit: bin/dg-agent-coord claim grok <path>. Prefer verify/board/loop-state + /api/coord dogfood; light head/blog only if claim free.
Foot only via DG_LOCK_OWNER=coord-grok bin/dg-lock …. 1-2 Ponytail wins. verify:source if foot/head edited.
Write grok-last.json {ok,at,did[],next,files[],claims[],lane:\"gates\",cycle:$c}. No auto-DM/game/thrash publish." \
      --always-approve --cwd "$ROOT" </dev/null \
      >>"$logf" 2>&1
    ec=$?
    write_exit_receipt "$DIR/grok-last.json" "$ec" "$logf" gates "$pre"
    release_owner_claims coord-grok
    set_track grok idle "done ec=$ec"
    if (( ec == 124 || ec != 0 )); then set_backoff grok 60; log "grok backoff 60s after ec=$ec"; fi
    rm -f "$GROK_PIDF"
    log "grok done ec=$ec"
    refresh_digest
  ) &
  echo $! >"$GROK_PIDF"
}

# One cycle id per wave: bump once if any role will spawn, pass same c to all
# $1 = force|once → spawn idle roles even when role_has_work=0 (manual audit)
spawn_wave() {
  local force="${1:-}"
  local need_c=0 need_x=0 need_g=0
  local g_c=$(( COORD_CLAUDE_TIMEOUT + 15 ))
  local g_x=$(( COORD_CODEX_TIMEOUT + 15 ))
  local g_g=$(( COORD_GROK_TIMEOUT + 15 ))
  if ! worker_active "$CLAUDE_PIDF" "$g_c" && ! backoff_active claude; then need_c=1; fi
  if ! worker_active "$CODEX_PIDF" "$g_x" && ! backoff_active codex; then need_x=1; fi
  if ! worker_active "$GROK_PIDF" "$g_g" && ! backoff_active grok; then need_g=1; fi
  if [[ "$force" != "force" && "$force" != "once" ]]; then
    (( need_c )) && [[ "$(role_has_work claude)" == "1" ]] || need_c=0
    (( need_x )) && [[ "$(role_has_work codex)" == "1" ]] || need_x=0
    (( need_g )) && [[ "$(role_has_work grok)" == "1" ]] || need_g=0
  fi
  if (( need_c + need_x + need_g == 0 )); then return 0; fi
  local c; c=$(bump_cycle)
  (( need_c )) && spawn_claude "$c" || true
  (( need_x )) && spawn_codex "$c" || true
  (( need_g )) && spawn_grok "$c" || true
}

loop() {
  trap 'rm -f "$PIDF"; reconcile_dead_supervisor' EXIT
  write_brief_or_digest() { refresh_digest; }
  write_brief_or_digest
  init_board
  for role in claude codex grok; do
    alive "$DIR/$role.pid" && set_track "$role" busy "worker survived supervisor restart" || { release_owner_claims "coord-$role"; set_track "$role" idle "supervisor startup recovery"; }
  done
  rm -f "$STOP"
  echo $$ >"$PIDF"
  touch "$HEARTBEAT"
  local tick="${COORD_TICK_SEC}"
  log "NONSTOP 3-worker start tick=${tick}s lanes=claude:website codex:tools grok:gates shared-cycle+honest-receipts"
  while [[ ! -f "$STOP" ]]; do
    spawn_wave || true
    local s=0
    while (( s < tick )) && [[ ! -f "$STOP" ]]; do
      sleep 5
      touch "$HEARTBEAT"
      s=$((s+5))
    done
    refresh_digest || true
  done
  log "stopped"
}

case "${1:-status}" in
  start)
    exec 9>"$DIR/start.lock"
    flock -n 9 || { echo "start already in progress"; exit 0; }
    if alive "$PIDF" || heartbeat_fresh; then echo "already $(cat "$PIDF" 2>/dev/null || echo pid-unobservable)"; exit 0; fi
    nohup "$0" _loop >>"$LOG" 2>&1 &
    echo $! >"$PIDF"
    touch "$HEARTBEAT"
    echo "started pid=$! (claude=website codex=tools grok=gates)"
    ;;
  _loop) loop ;;
  stop)
    date -Iseconds >"$STOP"
    rm -f "$HEARTBEAT"
    for role in claude codex grok; do set_track "$role" idle "interrupted by supervisor stop"; done
    for f in "$PIDF" "$CLAUDE_PIDF" "$CODEX_PIDF" "$GROK_PIDF"; do
      [[ -f "$f" ]] && kill "$(cat "$f")" 2>/dev/null || true
      rm -f "$f"
    done
    echo stopped
    ;;
  once)
    refresh_digest; init_board
    spawn_wave once
    echo spawned_once
    ;;
  claim)
    claim_hold "${2:-}" "${3:-}"
    ;;
  release-hold|unclaim)
    release_hold "${2:-}" "${3:-}"
    ;;
  claims)
    list_claims
    ;;
  brief|digest)
    reconcile_dead_supervisor
    refresh_digest
    cat "$CLAUDE_BRIEF"
    echo "---"
    head -40 "$DIGEST"
    ;;
  status|lanes)
    reconcile_dead_supervisor
    echo "stop=$([[ -f $STOP ]] && echo yes || echo no)"
    echo "supervisor=$(alive "$PIDF" && echo alive || { heartbeat_fresh && echo pid-unobservable || echo dead; }) pid=$(cat "$PIDF" 2>/dev/null || echo none)"
    echo "claude=$(alive "$CLAUDE_PIDF" && echo busy || { worker_active "$CLAUDE_PIDF" "$((COORD_CLAUDE_TIMEOUT+15))" && echo pid-unobservable || echo idle; }) lane=website"
    echo "codex=$(alive "$CODEX_PIDF" && echo busy || { worker_active "$CODEX_PIDF" "$((COORD_CODEX_TIMEOUT+15))" && echo pid-unobservable || echo idle; }) lane=tools"
    echo "grok=$(alive "$GROK_PIDF" && echo busy || { worker_active "$GROK_PIDF" "$((COORD_GROK_TIMEOUT+15))" && echo pid-unobservable || echo idle; }) lane=gates"
    echo "effective_tracks claude=$(alive "$CLAUDE_PIDF" && echo busy || { worker_active "$CLAUDE_PIDF" "$((COORD_CLAUDE_TIMEOUT+15))" && echo pid-unobservable || echo idle; }) codex=$(alive "$CODEX_PIDF" && echo busy || { worker_active "$CODEX_PIDF" "$((COORD_CODEX_TIMEOUT+15))" && echo pid-unobservable || echo idle; }) grok=$(alive "$GROK_PIDF" && echo busy || { worker_active "$GROK_PIDF" "$((COORD_GROK_TIMEOUT+15))" && echo pid-unobservable || echo idle; })"
    reconcile_dead_supervisor
    [[ -f "$BOARD" ]] && python3 -c "import json;b=json.load(open('$BOARD'));print('cycle',b.get('cycle'));print('persisted_tracks',{k:v.get('status') for k,v in (b.get('tracks') or {}).items() if k in ('claude','codex','grok','website','dash_tools','gates')})" 2>/dev/null || true
    alive "$PIDF" || heartbeat_fresh
    ;;
  restart)
    "$0" stop || true
    sleep 1
    rm -f "$STOP"
    "$0" start
    ;;
  *) echo "usage: $0 start|stop|status|lanes|once|brief|digest|restart|claim|release-hold|claims"; exit 2 ;;
esac
