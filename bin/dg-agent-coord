print(p.read_text())
PY
}

# Swarm P1: do not respawn idle roles when there is no actionable work (once forces).
# Tightened: ship/CSS lag alone must NOT keep all three lanes forever-busy (swarm full P1).
role_has_work() {
  local role="$1"
  python3 - "$role" "$DIR/quality-backlog.json" "$BOARD" "$CLAIMS" "$BUSY" "$ROOT" <<'PY'
import json, re, sys, time
from pathlib import Path
role = sys.argv[1]
qpath, bpath, cpath, busy = Path(sys.argv[2]), Path(sys.argv[3]), Path(sys.argv[4]), Path(sys.argv[5])
root = Path(sys.argv[6])

def ship_lag():
    try:
        s = json.loads((busy / "ship-status.json").read_text())
        f = s.get("facts") or {}
        d = str(f.get("diskVer") or "").replace("v", "")
        l = str(f.get("liveVer") or "").replace("v", "")
        m = str(f.get("manVer") or "").replace("v", "")
        return bool(d and ((l and d != l) or (m and d != m)))
    except Exception:
        return False

# open P0/P1 only for matching lane (or unassigned)
try:
    q = json.loads(qpath.read_text()) if qpath.exists() else {}
    for it in q.get("items") or []:
        if it.get("status") != "open" or it.get("sev") not in ("P0", "P1"):
            continue
        lane = (it.get("lane") or "").lower()
        if not lane or lane in (role, "any", "all"):
            print("1"); raise SystemExit(0)
        if role == "claude" and lane in ("website", "site"):
            print("1"); raise SystemExit(0)
        if role == "codex" and lane in ("tools", "dash", "dashboard", "webflow"):
            print("1"); raise SystemExit(0)
        if role == "grok" and lane in ("gates", "verify", "coord"):
            print("1"); raise SystemExit(0)
except Exception:
    pass

# Follow the active-focus redirect and inspect only its current Next section.
try:
    focus = busy / "lead-system/FOCUS.md"
    text = focus.read_text() if focus.exists() else ""
    target = re.search(r"`((?:/|\./)[^`]+/FOCUS\.md)`", text)
    if target:
        focus = Path(target.group(1)) if target.group(1).startswith("/") else root / target.group(1)
        text = focus.read_text()
    next_work = re.split(r"^##\s+Next\b", text, maxsplit=1, flags=re.M | re.I)
    next_work = re.split(r"^##\s+", next_work[1], maxsplit=1, flags=re.M)[0].lower() if len(next_work) == 2 else ""
    if role == "codex" and any(k in next_work for k in ("funnel", "drain", "tool", "bot")):
        print("1"); raise SystemExit(0)
    if role == "grok" and any(k in next_work for k in ("healthy", "heal", "status", "verify", "gate")):
        print("1"); raise SystemExit(0)
except Exception:
    pass

# Backlog: only lane-specific *new product* work — ignore pure ship/css thrash notes
try:
    b = json.loads(bpath.read_text()) if bpath.exists() else {}
    bl = [str(x) for x in (b.get("backlog") or [])]
    text = " ".join(bl).lower()
    shipish = any(k in text for k in ("css lag", "catbox", "paste", "cdn", "live v", "disk≠", "disk!="))
    if role == "claude":
        # website source work only if backlog names product gaps, not delivery lag
        product = any(k in text for k in ("designer", "wiz", "notes card", "blog post", "seo copy", "unhide", "a11y", "form "))
        if product and not (shipish and not product):
            print("1"); raise SystemExit(0)
        if any(k in text for k in ("wiz", "blog post", "notes card")):
            print("1"); raise SystemExit(0)
    if role == "codex":
        if any(k in text for k in ("dashboard", "dash bug", "webflow helper", "cm6", "claim", "coord claim", "tools-os", "funnel", "lead", "pipeline", "policy", "events bot", "events-bot")):
            print("1"); raise SystemExit(0)
    if role == "grok":
        if any(k in text for k in ("loop-state", "board honesty", "verify fail", "gate fail")):
            print("1"); raise SystemExit(0)
except Exception:
    pass

# Ship lag: Codex owns Webflow paste tooling only (not Claude thrash, not endless Grok waves)
if ship_lag() and role == "codex":
    print("1"); raise SystemExit(0)
# Grok dogfood ship lag at most every 12 minutes (receipt age)
if ship_lag() and role == "grok":
    try:
        receipts = [json.loads(p.read_text()) for p in (
            busy / "coord/grok-last.json", busy / "coord/term-grok-last.json"
        ) if p.exists()]
        rec = max(receipts, key=lambda x: str(x.get("at", "")))
        age = time.time() - __import__("datetime").datetime.fromisoformat(
            str(rec.get("at", "")).replace("Z", "+00:00")
        ).timestamp()
        if age > 12 * 60:
            print("1"); raise SystemExit(0)
    except Exception:
        print("1"); raise SystemExit(0)

print("0")
PY
}

inbox() {
  flock -x 9
  rotate_log "$INBOX"
  printf '{"at":"%s","from":"%s","msg":%s}\n' "$(date -Iseconds)" "$1" "$(python3 -c 'import json,sys;print(json.dumps(sys.argv[1]))' "$2")" >>"$INBOX"
} 9>"$DIR/inbox.lock"

# Agents often write $BUSY/<role>-last.json; supervisor expects $DIR/<role>-last.json.
# Promote a run-scoped alt receipt (mtime > pre) so write_exit_receipt sees a fresh primary write.
promote_alt_receipt() {
  # $1 role  $2 pre_mtime_ns
  local role="$1" pre="${2:-0}" primary="$DIR/${role}-last.json" alt="$BUSY/${role}-last.json"
  [[ -f "$alt" ]] || return 0
  local alt_ns; alt_ns=$(receipt_mtime_ns "$alt")
  (( alt_ns > pre )) || return 0
  python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert isinstance(d,dict) and ("did" in d or "ok" in d)' "$alt" 2>/dev/null || return 0
  cp -a "$alt" "$primary" 2>/dev/null || cp "$alt" "$primary"
}

write_exit_receipt() {
  # $1 path $2 exit $3 logpath $4 lane $5 pre_mtime_ns (0 if none)
  # Preserve prior ok:true ONLY if agent rewrote the receipt during this run (mtime advanced).
  # Stops timeouts from advertising stale success (swarm P1).
  # Last-good: when overwriting success with empty fail, keep sibling *.last-good.json (receipt separation).
  python3 - <<PY
import json, datetime, pathlib, os
p=pathlib.Path("$1")
log=pathlib.Path("$3")
lane="$4"
pre_ns=int("${5:-0}" or "0")
ec=int("$2")
tail=log.read_text(errors="replace")[-2500:] if log.exists() else ""
try:
  prev=json.loads(p.read_text())
except Exception:
  prev=None
post_ns=0
try:
  post_ns=p.stat().st_mtime_ns
except Exception:
  pass

def _is_good(d):
  return isinstance(d, dict) and d.get("ok") is True and bool(d.get("did"))

def _save_last_good(d):
  if not _is_good(d):
    return
  lg = p.with_name(p.name.replace(".json", "") + ".last-good.json")
  tmp_lg = lg.with_name(f".{lg.name}.{os.getpid()}.tmp")
  payload = dict(d)
  payload["lastGoodAt"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
  tmp_lg.write_text(json.dumps(payload, indent=2) + "\n")
  tmp_lg.chmod(0o600)
  tmp_lg.replace(lg)

# Agent wrote during this run if mtime advanced past pre-spawn snapshot
fresh_write = isinstance(prev, dict) and post_ns > pre_ns
if fresh_write:
  if _is_good(prev) and (ec != 0 or prev.get("ok") is False):
    _save_last_good(prev)
  prev.setdefault("lane", lane)
  if ec != 0:
    prev["workerVerdict"] = prev.get("ok")
    prev["ok"] = False
  if prev.get("ok") is False and not any(prev.get(k) for k in ("reason", "error", "tail")):
    prev["reason"] = "agent reported failure" if ec == 0 else f"process exit {ec}"
  prev["exit"]=ec
  prev["supervisorNote"]=f"process exit {ec}; {'overrode' if ec else 'kept'} agent receipt verdict (mtime advanced this run)"
  if "at" not in prev:
    prev["at"]=datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
else:
  # No fresh agent receipt means no run-scoped success evidence, regardless of exit code.
  # Archive last-good from primary and/or BUSY alt so failed cycles do not erase coord truth.
  _save_last_good(prev)
  try:
    alt = pathlib.Path(os.environ.get("DG_BUSY", "/tmp/dg-busy")) / p.name
    if alt.resolve() != p.resolve() and alt.is_file():
      _save_last_good(json.loads(alt.read_text()))
  except Exception:
    pass
  prev = {
    "at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "exit": ec,
    "ok": False,
    "lane": lane,
    "did": [],
    "staleSuccessAvoided": bool(isinstance(prev, dict) and prev.get("ok") is True),
    "reason": "worker exited without fresh receipt" if ec == 0 else f"process exit {ec}",
    "tail": tail[-1500:] if ec != 0 else "",
    "lastGoodPath": str(p.with_name(p.name.replace(".json", "") + ".last-good.json")),
  }
tmp=p.with_name(f".{p.name}.{os.getpid()}.tmp")
tmp.write_text(json.dumps(prev, indent=2)+"\n")
tmp.chmod(0o600)
tmp.replace(p)
PY
}

receipt_mtime_ns() {
  # $1 path → mtime ns or 0
  python3 -c "import pathlib;p=pathlib.Path('$1');print(p.stat().st_mtime_ns if p.exists() else 0)" 2>/dev/null || echo 0
}

# Backoff after timeout(124)/fail — file mtime = next-allowed spawn
backoff_active() {
  local f="$DIR/${1}.backoff"
  [[ -f "$f" ]] || return 1
  local until now
  until=$(tr -d ' \n' <"$f" 2>/dev/null || echo 0)
  now=$(date +%s)
  (( now < until ))
}
set_backoff() {
  # $1 role $2 seconds
  echo $(( $(date +%s) + ${2:-60} )) >"$DIR/${1}.backoff"
}

failure_backoff() {
  # Quota failures are not transient; stop retrying them every coordinator tick.
  # Codex CLI: "You've hit your usage limit... try again at Jul 28th, 2026 10:02 AM"
  if ! grep -Eqi 'weekly limit|usage balance exhausted|status 402|http_status[^0-9]*402|hit your usage limit|usage limit' "$1"; then
    echo "$2"
    return 0
  fi
  local secs
  secs=$(LOGF="$1" python3 - <<'PY'
import os, re, time, datetime
from pathlib import Path
text = Path(os.environ["LOGF"]).read_text(errors="ignore")
m = re.search(r"try again at\s+(.+?)(?:\.|$|\n)", text, re.I)
if m:
    s = re.sub(r"(\d+)(st|nd|rd|th)", r"\1", m.group(1).strip())
    for fmt in ("%b %d, %Y %I:%M %p", "%B %d, %Y %I:%M %p", "%b %d %Y %I:%M %p"):
        try:
            dt = datetime.datetime.strptime(s, fmt)
            print(max(3600, int(dt.timestamp() - time.time())))
            raise SystemExit
        except ValueError:
            pass
print(21600)  # 6h floor when parse fails
PY
)
  echo "${secs:-21600}"
}

# Spawn helpers: optional cycle id $1 (shared tick). If empty, bump for this spawn only.
spawn_claude() (
  local spawn_fd; exec {spawn_fd}>"$DIR/claude-spawn.lock"
  flock -n "$spawn_fd" || return 0
  worker_active "$CLAUDE_PIDF" && return 0
  if backoff_active claude; then return 0; fi
  rotate_log "$DIR/claude-run.log"
  local c="${1:-}"
  [[ -n "$c" ]] || c=$(bump_cycle)
  local logf="$DIR/claude-run.log"
  local pre; pre=$(receipt_mtime_ns "$DIR/claude-last.json")
  refresh_digest
  set_track claude busy "spawn c=$c website lane"
  log "spawn claude c=$c lane=website"
  inbox supervisor "spawn claude c=$c lane=website"
  (
    set +e
    timeout "$COORD_CLAUDE_TIMEOUT" stdbuf -oL -eL claude -p \
"Demigod NONSTOP cycle $c · LANE=website (foot/head/blog only).
READ /tmp/dg-busy/coord/digest.md + /tmp/dg-busy/swarm/latest.md first (peer receipts only if digest flags conflict).
Before editing any hot file: bin/dg-agent-coord claim claude <path> (fail=skip that file). Foot: DG_LOCK_OWNER=coord-claude bin/dg-lock …
NORTH STAR: website product first. 1-2 Ponytail site wins. verify:source if foot/head edited.
FORBIDDEN: demigod-agent-dashboard*. Production SoRs are read-only; use /tmp fixtures. No auto-DM/game/thrash publish.
Write $DIR/claude-last.json {ok,at,did[],next,files[],claims[],lane:\"website\",cycle:$c}." \
      --dangerously-skip-permissions --permission-mode bypassPermissions \
      --model "${COORD_CLAUDE_MODEL:-sonnet}" --add-dir "$ROOT" \
      >>"$logf" 2>&1
    ec=$?
    release_owner_claims coord-claude
    set_track claude idle "done ec=$ec"
    if (( ec == 124 || ec != 0 )); then delay=$(failure_backoff "$logf" 90); set_backoff claude "$delay"; log "claude backoff ${delay}s after ec=$ec"; fi
    rm -f "$CLAUDE_PIDF"
    promote_alt_receipt claude "$pre"; write_exit_receipt "$DIR/claude-last.json" "$ec" "$logf" website "$pre"
    log "claude done ec=$ec"
    refresh_digest
  ) &
  echo $! >"$CLAUDE_PIDF"
)

spawn_codex() (
  local spawn_fd; exec {spawn_fd}>"$DIR/codex-spawn.lock"
  flock -n "$spawn_fd" || return 0
  worker_active "$CODEX_PIDF" && return 0
  if backoff_active codex; then return 0; fi
  rotate_log "$DIR/codex-run.log"
  local c="${1:-}"
  [[ -n "$c" ]] || c=$(bump_cycle)
  local logf="$DIR/codex-run.log"
  local pre; pre=$(receipt_mtime_ns "$DIR/codex-last.json")
  refresh_digest
  set_track codex busy "spawn c=$c tools lane"
  log "spawn codex c=$c lane=tools"
  inbox supervisor "spawn codex c=$c lane=tools"
  (
    set +e
    timeout "$COORD_CODEX_TIMEOUT" stdbuf -oL -eL codex exec --full-auto --sandbox workspace-write \
"Demigod NONSTOP cycle $c · LANE=tools (dash/webflow/funnel tooling).
READ /tmp/dg-busy/coord/digest.md + /tmp/dg-busy/swarm/latest.md first.
Before edit: bin/dg-agent-coord claim codex <path>. Prefer the named tools backlog: funnel/lead/pipeline/policy/events, Webflow helpers, or dash.
NORTH STAR: product first. 1-2 Ponytail tools/Webflow wins. FORBIDDEN: demigod-foot-core.js.
Production SoRs, including DEMIGOD-EVENTS.json, are read-only. Use an isolated /tmp fixture; report cleanup proposals without rewriting live store data.
Write /tmp/dg-busy/coord/codex-last.json {ok,at,did,files,claims[],verification,lane:\"tools\",cycle:$c}. No auto-DM/game." \
      >>"$logf" 2>&1
    ec=$?
    release_owner_claims coord-codex
    set_track codex idle "done ec=$ec"
    if (( ec == 124 || ec != 0 )); then delay=$(failure_backoff "$logf" 60); set_backoff codex "$delay"; log "codex backoff ${delay}s after ec=$ec"; fi
    rm -f "$CODEX_PIDF"
    promote_alt_receipt codex "$pre"; write_exit_receipt "$DIR/codex-last.json" "$ec" "$logf" tools "$pre"
    log "codex done ec=$ec"
    refresh_digest
  ) &
  echo $! >"$CODEX_PIDF"
)

spawn_grok() (
  local spawn_fd; exec {spawn_fd}>"$DIR/grok-spawn.lock"
  flock -n "$spawn_fd" || return 0
  worker_active "$GROK_PIDF" && return 0
  if backoff_active grok; then return 0; fi
  command -v grok >/dev/null 2>&1 || { log "grok CLI missing"; return 0; }
  rotate_log "$DIR/grok-run.log"
  local c="${1:-}"
  [[ -n "$c" ]] || c=$(bump_cycle)
  local logf="$DIR/grok-run.log"
  local pre; pre=$(receipt_mtime_ns "$DIR/grok-last.json")
  refresh_digest
  set_track grok busy "spawn c=$c gates lane"
  log "spawn grok c=$c lane=gates"
  inbox supervisor "spawn grok c=$c lane=gates"
  (
    set +e
    GROK_ASK_TIMEOUT="$COORD_GROK_TIMEOUT" stdbuf -oL -eL grok-ask \
"Demigod NONSTOP Grok cycle $c · LANE=gates+coord.
READ /tmp/dg-busy/coord/digest.md + /tmp/dg-busy/swarm/latest.md first.
Before hot-file edit: bin/dg-agent-coord claim grok <path>. Prefer verify/board/loop-state + /api/coord dogfood; website SoR only when board.json explicitly assigns that resource to Grok.
An explicitly assigned foot edit still requires DG_LOCK_OWNER=coord-grok bin/dg-lock …. 1-2 Ponytail wins. verify:source if foot/head edited.
Production SoRs, including DEMIGOD-EVENTS.json, are read-only. Use an isolated /tmp fixture; report cleanup proposals without rewriting live store data.
Write $DIR/grok-last.json {ok,at,did[],next,files[],claims[],lane:\"gates\",cycle:$c}. No publish, outbound, forms, money, or game unless this exact task carries current user authorization." \
      </dev/null \
      >>"$logf" 2>&1
    ec=$?
    release_owner_claims coord-grok
    set_track grok idle "done ec=$ec"
    if (( ec == 124 || ec != 0 )); then delay=$(failure_backoff "$logf" 60); set_backoff grok "$delay"; log "grok backoff ${delay}s after ec=$ec"; fi
    rm -f "$GROK_PIDF"
    promote_alt_receipt grok "$pre"; write_exit_receipt "$DIR/grok-last.json" "$ec" "$logf" gates "$pre"
    log "grok done ec=$ec"
    refresh_digest
  ) &
  echo $! >"$GROK_PIDF"
)

# One cycle id per wave: bump once if any role will spawn, pass same c to all
# $1 = force → bypass role_has_work; $2 optionally limits the wave to one role
spawn_wave() {
  local force="${1:-}"
  local only="${2:-}"
  local need_c=0 need_x=0 need_g=0
  local g_c=$(( COORD_CLAUDE_TIMEOUT + 15 ))
  local g_x=$(( COORD_CODEX_TIMEOUT + 15 ))
  local g_g=$(( COORD_GROK_TIMEOUT + 15 ))
  if ! worker_active "$CLAUDE_PIDF" "$g_c" && ! backoff_active claude; then need_c=1; fi
  if ! worker_active "$CODEX_PIDF" "$g_x" && ! backoff_active codex; then need_x=1; fi
  if ! worker_active "$GROK_PIDF" "$g_g" && ! backoff_active grok; then need_g=1; fi
  [[ -z "$only" || "$only" == "claude" ]] || need_c=0
  [[ -z "$only" || "$only" == "codex" ]] || need_x=0
  [[ -z "$only" || "$only" == "grok" ]] || need_g=0
  if [[ "$force" != "force" ]]; then
    (( need_c )) && [[ "$(role_has_work claude)" == "1" ]] || need_c=0
    (( need_x )) && [[ "$(role_has_work codex)" == "1" ]] || need_x=0
    (( need_g )) && [[ "$(role_has_work grok)" == "1" ]] || need_g=0
  fi
  if (( need_c + need_x + need_g == 0 )); then return 0; fi
  local c; c=$(bump_cycle)
  (( need_c )) && spawn_claude "$c" || true
  (( need_x )) && spawn_codex "$c" || true
  (( need_g )) && spawn_grok "$c" || true
}

loop() {
  trap 'rm -f "$PIDF"; reconcile_dead_supervisor' EXIT
  write_brief_or_digest() { refresh_digest; }
  write_brief_or_digest
  init_board
  for role in claude codex grok; do
    alive "$DIR/$role.pid" && set_track "$role" busy "worker survived supervisor restart" || { release_owner_claims "coord-$role"; set_track "$role" idle "supervisor startup recovery"; }
  done
  rm -f "$STOP"
  echo $$ >"$PIDF"
  touch "$HEARTBEAT"
  local tick="${COORD_TICK_SEC}"
  log "NONSTOP 3-worker start tick=${tick}s lanes=claude:website codex:tools grok:gates shared-cycle+honest-receipts"
  while [[ ! -f "$STOP" ]]; do
    spawn_wave || true
    local s=0
    while (( s < tick )) && [[ ! -f "$STOP" ]]; do
      sleep 5
      touch "$HEARTBEAT"
      s=$((s+5))
    done
    refresh_digest || true
  done
  log "stopped"
}

case "${1:-status}" in
  start)
    exec 9>"$DIR/start.lock"
    flock -n 9 || { echo "start already in progress"; exit 0; }
    if alive "$PIDF" || heartbeat_fresh; then echo "already $(cat "$PIDF" 2>/dev/null || echo pid-unobservable)"; exit 0; fi
    nohup "$0" _loop >>"$LOG" 2>&1 &
    echo $! >"$PIDF"
    touch "$HEARTBEAT"
    echo "started pid=$! (claude=website codex=tools grok=gates)"
    ;;
  _loop) loop ;;
  stop)
    date -Iseconds >"$STOP"
    rm -f "$HEARTBEAT"
    for role in claude codex grok; do set_track "$role" idle "interrupted by supervisor stop"; done
    for f in "$PIDF" "$CLAUDE_PIDF" "$CODEX_PIDF" "$GROK_PIDF"; do
      [[ -f "$f" ]] && kill "$(cat "$f")" 2>/dev/null || true
      rm -f "$f"
    done
    echo stopped
    ;;
  once)
    refresh_digest; init_board
    case "${2:-}" in
      "") spawn_wave ;;
      all) spawn_wave force ;;
      claude|codex|grok) spawn_wave force "$2" ;;
      *) echo "usage: $0 once [claude|codex|grok|all]" >&2; exit 2 ;;
    esac
    echo spawned_once
    ;;
  claim)
    claim_hold "${2:-}" "${3:-}"
    ;;
  renew)
    renew_hold "${2:-}" "${3:-}"
    ;;
  release-hold|unclaim)
    release_hold "${2:-}" "${3:-}"
    ;;
  claims)
    list_claims
    ;;
  brief|digest)
    reconcile_dead_supervisor
    refresh_digest
    cat "$CLAUDE_BRIEF"
    echo "---"
    head -40 "$DIGEST"
    ;;
  status|lanes)
    reconcile_dead_supervisor
    echo "stop=$([[ -f $STOP ]] && echo yes || echo no)"
    echo "supervisor=$(alive "$PIDF" && echo alive || { heartbeat_fresh && echo pid-unobservable || echo dead; }) pid=$(cat "$PIDF" 2>/dev/null || echo none)"
    echo "claude=$(alive "$CLAUDE_PIDF" && echo busy || { worker_active "$CLAUDE_PIDF" "$((COORD_CLAUDE_TIMEOUT+15))" && echo pid-unobservable || echo idle; }) lane=website"
    echo "codex=$(alive "$CODEX_PIDF" && echo busy || { worker_active "$CODEX_PIDF" "$((COORD_CODEX_TIMEOUT+15))" && echo pid-unobservable || echo idle; }) lane=tools"
    echo "grok=$(alive "$GROK_PIDF" && echo busy || { worker_active "$GROK_PIDF" "$((COORD_GROK_TIMEOUT+15))" && echo pid-unobservable || echo idle; }) lane=gates"
    echo "effective_tracks claude=$(alive "$CLAUDE_PIDF" && echo busy || { worker_active "$CLAUDE_PIDF" "$((COORD_CLAUDE_TIMEOUT+15))" && echo pid-unobservable || echo idle; }) codex=$(alive "$CODEX_PIDF" && echo busy || { worker_active "$CODEX_PIDF" "$((COORD_CODEX_TIMEOUT+15))" && echo pid-unobservable || echo idle; }) grok=$(alive "$GROK_PIDF" && echo busy || { worker_active "$GROK_PIDF" "$((COORD_GROK_TIMEOUT+15))" && echo pid-unobservable || echo idle; })"
    reconcile_dead_supervisor
    [[ -f "$BOARD" ]] && python3 -c "import json;b=json.load(open('$BOARD'));print('cycle',b.get('cycle'));print('persisted_tracks',{k:v.get('status') for k,v in (b.get('tracks') or {}).items() if k in ('claude','codex','grok','website','dash_tools','gates')})" 2>/dev/null || true
    alive "$PIDF" || heartbeat_fresh
    ;;
  restart)
    "$0" stop || true
    sleep 1
    rm -f "$STOP"
    "$0" start
    ;;
  *) echo "usage: $0 start|stop|status|lanes|once [claude|codex|grok|all]|brief|digest|restart|claim|renew|release-hold|claims"; exit 2 ;;
esac
