#!/usr/bin/env bash
# Anti-bloat research helper for multi-agent Demigod.
#   bin/dg-anti-bloat pick [--context=thrash|timers|product|tools|gtm|auto]
#   bin/dg-anti-bloat list
#   bin/dg-anti-bloat log --id=A1 --query="..." --bullets="..." [--apply="..."]
#   bin/dg-anti-bloat status
#   bin/dg-anti-bloat doctrine   # print north star for agents
set -euo pipefail
ROOT="${DEMIGOD_ROOT:-$HOME}"
COORD="${DEMIGOD_BUSY:-/tmp/dg-busy}/coord"
CATALOG="$ROOT/docs/DEMIGOD-ANTI-BLOAT-SEARCHES.md"
LAST="$COORD/anti-bloat-last.json"
NOTES="$COORD/anti-bloat-notes"
STATE="$COORD/anti-bloat-state.json"
mkdir -p "$COORD" "$NOTES"
export PATH="${HOME}/.local/bin:${HOME}/bin:/usr/bin:/bin:${PATH}"

doctrine() {
  cat <<'D'
## North star (all agents)
Improve **Demigod the product**: website honesty, WIZ/matching UX, ship quality, GTM-ready proof.
Orchestration (coord/swarm/timers/maps) is scaffolding — cut anything that does not serve the product.
Prefer 1 solid site win over 3 meta-tool wins. Ponytail + YAGNI. Clear stop conditions.
Removal is first-class: delete bad copy, dead code, useless timers, wrong features.
Creation is first-class: new pages, better WIZ/form copy, Notes, SEO — whatever raises dual-sided submits + match quality.

## Ship cadence (critical)
Do **not** let disk lead live by dozens of versions. After a meaningful batch of foot/head/blog wins:
  bin/dg ship prepare && DG_LOCK_OWNER=ship bin/dg-lock true  # or claim
  bin/dg ship run     # cdn → CM6 paste → verify
  bin/dg ship verify
You may also write blog posts, legal/copy, head SEO, dash tools — anything a technical startup employee would.

Quality: bin/dg-quality once (audits/bugfix/sim-user before more features).
Research: docs/DEMIGOD-ANTI-BLOAT-SEARCHES.md · bin/dg-anti-bloat pick|log
D
}

cmd="${1:-status}"
shift || true

case "$cmd" in
  doctrine) doctrine; exit 0 ;;
  list)
    [[ -f "$CATALOG" ]] && sed -n '/^## Search catalog/,/^## Context/p' "$CATALOG" | head -80
    ;;
  status)
    doctrine
    echo "---"
    [[ -f "$LAST" ]] && cat "$LAST" || echo "no anti-bloat-last.json yet"
    ;;
  pick)
    CTX="auto"
    for a in "$@"; do
      case "$a" in
        --context=*) CTX="${a#--context=}" ;;
        --from-swarm) CTX="thrash" ;;
        *)
          echo "dg-anti-bloat: unknown argument $a — try: bin/dg-anti-bloat pick [--context=…]" >&2
          exit 2
          ;;
      esac
    done
    # auto-detect smells
    if [[ "$CTX" == auto ]]; then
      foot=$(grep -oE "__dgFootVer='[0-9]+'" "$ROOT/demigod-foot-core.js" 2>/dev/null | head -1 || true)
      timers=$(systemctl --user list-timers --all 2>/dev/null | grep -c demigod || true)
      if [[ "${timers:-0}" -ge 4 ]]; then CTX=timers
      elif [[ -f /tmp/dg-busy/coord/coord.log ]] && grep -q 'ec=124' /tmp/dg-busy/coord/coord.log 2>/dev/null; then CTX=thrash
      else CTX=product
      fi
    fi
    # rotate index per context
    python3 - "$CTX" "$STATE" <<'PY'
import json, sys, hashlib
from pathlib import Path
from datetime import datetime, timezone
ctx = sys.argv[1]
state_p = Path(sys.argv[2])
pools = {
  "thrash": ["A1","A2","B2","B1","D5"],
  "timers": ["A4","B5","D3","A2","D1"],
  "product": ["C1","C5","C2","C4","C3"],
  "tools": ["D1","D2","D4","A3","B5"],
  "gtm": ["E4","C2","C5","E1"],
  "auto": ["C1","A1","D5","B2","E3"],
}
pool = pools.get(ctx, pools["product"])
st = {}
if state_p.exists():
  try: st = json.loads(state_p.read_text())
  except Exception: st = {}
idx = int(st.get("idx", {}).get(ctx, 0)) % len(pool)
pick = pool[idx]
st.setdefault("idx", {})[ctx] = idx + 1
st["last_ctx"] = ctx
st["last_id"] = pick
st["at"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
state_p.write_text(json.dumps(st, indent=2) + "\n")
# map id to query from catalog hardcode
queries = {
  "A1": "when multi-agent AI is overkill single agent faster coding",
  "A2": "multi-agent coordination overhead more agents hurt performance",
  "A3": "AI agent orchestration start simple scale smart maturity model",
  "A4": "reduce agent sprawl enterprise AI agent orchestration 2026",
  "A5": "planner worker separation AI agents reduce lock contention",
  "B1": "agent loop engineering stop condition verify before architecture",
  "B2": "coding agent thrashing continuous improve loop anti-patterns",
  "B3": "Andrew Ng agentic coding loop feedback loop product",
  "B4": "self-improving coding agents telemetry traces as source of truth",
  "B5": "AI agent cost optimization tool call overhead token waste",
  "C1": "startup landing page conversion honesty pre-launch talent marketplace",
  "C2": "B2B marketplace two-sided matching UX reduce friction founders",
  "C3": "web performance Core Web Vitals SPA marketing site 2026",
  "C4": "accessible form wizard multi-step form UX mobile conversion",
  "C5": "copywriting trust signals hiring marketplace no fake social proof",
  "D1": "delete code reduce complexity software entropy continuous delivery",
  "D2": "observability for AI agents without dashboard sprawl",
  "D3": "YAGNI for automation scripts systemd timer hygiene",
  "D4": "documentation that agents read single source of truth digest",
  "D5": "feature freeze ship candidate vs continuous micro-versioning",
  "E1": "site:news.ycombinator.com multi agent overengineered",
  "E2": "site:reddit.com/r/LocalLLaMA agent swarm waste",
  "E3": "less agents better OR single agent coding workflow 2026",
  "E4": "talent marketplace GTM SF founders cold outreach without spam",
  "E5": "Webflow custom code maintainability head footer pattern",
}
q = queries.get(pick, pick)
print(f"context={ctx}")
print(f"id={pick}")
print(f"query={q}")
print(f"hint=Search the web for that query; log with: bin/dg-anti-bloat log --id={pick} --query=... --bullets='...'")
print(f"catalog=docs/DEMIGOD-ANTI-BLOAT-SEARCHES.md")
print(f"doctrine=bin/dg-anti-bloat doctrine")
PY
    ;;
  log)
    # parse simple --id= --query= --bullets= --apply=
    ID=""; Q=""; B=""; A=""
    for a in "$@"; do
      case "$a" in
        --id=*) ID="${a#--id=}" ;;
        --query=*) Q="${a#--query=}" ;;
        --bullets=*) B="${a#--bullets=}" ;;
        --apply=*) A="${a#--apply=}" ;;
      esac
    done
    python3 - "$ID" "$Q" "$B" "$A" "$LAST" "$NOTES" <<'PY'
import json, sys
from pathlib import Path
from datetime import datetime, timezone
id_, q, b, apply, last, notes = sys.argv[1:7]
now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
bullets = [x.strip() for x in b.split(";") if x.strip()] if b else []
data = {
  "schema": "demigod.anti-bloat/1",
  "ok": True,
  "at": now,
  "id": id_ or "?",
  "query": q,
  "bullets": bullets,
  "apply": apply or None,
  "north_star": "website + Demigod product quality first; cut scaffolding that does not serve it",
}
Path(last).write_text(json.dumps(data, indent=2) + "\n")
nd = Path(notes)
nd.mkdir(parents=True, exist_ok=True)
(nd / f"{now[:10]}-{(id_ or 'x')}.md").write_text(
  f"# anti-bloat {id_} · {now}\n\n**Query:** {q}\n\n"
  + "\n".join(f"- {x}" for x in bullets)
  + (f"\n\n**Apply:** {apply}\n" if apply else "\n")
)
print("logged", last)
PY
    ;;
  *)
    echo "usage: $0 doctrine|list|pick [--context=…]|log --id= --query= --bullets=|status"
    exit 2
    ;;
esac
