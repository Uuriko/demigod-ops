#!/usr/bin/env bash
# Generic swarm inbox drainer for ONE agent (grok|codex|claude).
# Lets any agent hand off a task: drop /tmp/dg-busy/<agent>-inbox/<id>.req
#   (write <id>.tmp then `mv` to <id>.req — atomic). Reply -> /tmp/dg-busy/<agent>-out/<id>.res
# Mirror of claude-yolo-loop, but dispatches to the target agent's CLI.
#   agent-inbox-drainer grok run|status|stop
# Safety: honors a GLOBAL kill switch /tmp/dg-busy/swarm.STOP and a per-agent STOP.
#   Codex runs read-only by default (CODEX_SANDBOX to override). The drainer never
#   self-generates work — it only runs what's queued, so it can't run away on its own.
set -euo pipefail
AGENT="${1:?usage: agent-inbox-drainer <grok|codex|claude> [run|status|stop]}"
cmd="${2:-run}"
export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.nvm/versions/node/v24.17.0/bin:/usr/bin:/bin:$PATH"
ROOT="${DEMIGOD_ROOT:-$HOME}"
BUSY="${DEMIGOD_BUSY:-/tmp/dg-busy}"
INBOX="$BUSY/${AGENT}-inbox"; OUT="$BUSY/${AGENT}-out"
LOG="$BUSY/${AGENT}-drainer.log"; PIDF="$BUSY/${AGENT}-drainer.pid"
STOP="$BUSY/${AGENT}-drainer.STOP"; GSTOP="$BUSY/swarm.STOP"; HEART="$BUSY/${AGENT}-drainer.heartbeat"
TIMEOUT="${DRAIN_TIMEOUT_SEC:-240}"
POLL="${DRAIN_POLL_SEC:-3}"
COOLDOWN="${DRAIN_COOLDOWN_SEC:-2}"
CODEX_SANDBOX="${CODEX_SANDBOX:-read-only}"
mkdir -p "$INBOX" "$OUT"; cd "$ROOT"

case "$cmd" in
  stop)   date -Iseconds >"$STOP"; [[ -f $PIDF ]] && kill "$(cat "$PIDF")" 2>/dev/null; rm -f "$PIDF"; echo "stopped $AGENT"; exit 0;;
  status) echo "agent=$AGENT stop=$([[ -f $STOP || -f $GSTOP ]] && echo yes || echo no) pid=$(cat "$PIDF" 2>/dev/null||echo none) pending=$(ls "$INBOX"/*.req 2>/dev/null | wc -l | tr -d ' ')"; tail -10 "$LOG" 2>/dev/null; exit 0;;
esac

run_agent() { # $1 = prompt ; stdout = reply
  case "$AGENT" in
    grok)   GROK_ASK_TIMEOUT="$TIMEOUT"  grok-ask   "$1";;
    claude) ASK_CLAUDE_TIMEOUT="$TIMEOUT" ask-claude "$1";;
    # No 2>&1 here. The caller already routes streams correctly (run_agent ... >"$out" 2>>"$LOG"):
    # stdout is the REPLY, stderr is diagnostics. Merging them inside defeated that and dumped the
    # whole session prelude + transcript into the .res -- one reply came back 104KB, of which the
    # answer was a few lines and the rest was codex's stderr (skill preamble, "tokens used", the
    # raw output of everything it ran). Verified: `codex exec` puts the clean answer on stdout
    # (5 bytes "PONG") and 723 bytes of noise on stderr. grok/claude never merged; codex was alone.
    codex)  timeout "$TIMEOUT" codex exec -s "$CODEX_SANDBOX" -C "$ROOT" "$1" </dev/null;;
    *) echo "unknown agent: $AGENT" >&2; return 3;;
  esac
}

log(){ echo "[$(date -Iseconds)] $*" | tee -a "$LOG"; }

write_response_meta() { # response receipt exit started_epoch
  local response="$1" receipt="$2" exit_code="$3" started="$4" ok=false
  [[ "$exit_code" -eq 0 ]] && ok=true
  printf '{"schema":"demigod.agent-response/1","at":"%s","exit":%d,"ok":%s,"bytes":%d,"durationSec":%d}\n' \
    "$(date -Iseconds)" "$exit_code" "$ok" "$(stat -c %s "$response")" "$(( $(date +%s) - started ))" >"$receipt.wip"
  chmod 600 "$receipt.wip"
  mv -f "$receipt.wip" "$receipt"
}

if [[ "$cmd" == "selftest-meta" ]]; then
  test_dir=$(mktemp -d); trap 'rm -rf "$test_dir"' EXIT
  printf test >"$test_dir/sample.res"
  write_response_meta "$test_dir/sample.res" "$test_dir/sample.meta.json" 124 "$(( $(date +%s) - 2 ))"
  meta_text=$(<"$test_dir/sample.meta.json")
  [[ "$meta_text" == *'"exit":124,"ok":false,"bytes":4'* && "$(stat -c %a "$test_dir/sample.meta.json")" == 600 ]] || {
    echo "agent response metadata selftest FAIL" >&2; exit 1;
  }
  echo "agent response metadata selftest PASS"; exit 0
fi

rm -f "$STOP"; echo $$ >"$PIDF"
log "DRAIN START agent=$AGENT inbox=$INBOX timeout=${TIMEOUT}s sandbox=${CODEX_SANDBOX}"
if [[ "$AGENT" == "grok" ]]; then
  DEMIGOD_BUSY="$BUSY" node "$ROOT/demigod-agent-dashboard.mjs" --project-grok-out >>"$LOG" 2>&1 ||
    log "WARN startup shared Grok receipt projection failed"
fi

# Recover orphaned claims: a .run left by a crashed/killed predecessor is a silently-lost task.
# One drainer instance per agent (systemd), so at startup any .run is stale → requeue it.
for r in "$INBOX"/*.run; do
  [ -e "$r" ] || continue
  mv "$r" "${r%.run}.req" 2>/dev/null && log "requeued orphaned claim $(basename "$r")"
done

while [[ ! -f "$STOP" && ! -f "$GSTOP" ]]; do
  date -Iseconds >"$HEART"
  req=$(ls -1tr "$INBOX"/*.req 2>/dev/null | head -1 || true)
  if [[ -z "$req" ]]; then
    for ((s=0; s<POLL; s++)); do [[ -f $STOP || -f $GSTOP ]] && break; ls "$INBOX"/*.req >/dev/null 2>&1 && break; sleep 1; done
    continue
  fi
  base=$(basename "$req" .req); run="$INBOX/$base.run"; out="$OUT/$base.res"; meta="$OUT/$base.meta.json"
  mv "$req" "$run" 2>/dev/null || continue     # another claimant won the race
  log "REQ $base"
  started_epoch=$(date +%s)
  set +e; run_agent "$(cat "$run")" >"$out.wip" 2>>"$LOG"; ec=$?; set -e
  chmod 600 "$out.wip"
  mv -f "$out.wip" "$out"   # atomic publish: .res appears only when complete (no 0-byte false-"done" for pollers)
  write_response_meta "$out" "$meta" "$ec" "$started_epoch"
  rm -f "$run"
  if [[ "$AGENT" == "grok" ]]; then
    DEMIGOD_BUSY="$BUSY" node "$ROOT/demigod-agent-dashboard.mjs" --project-grok-out >>"$LOG" 2>&1 ||
      log "WARN $base shared Grok receipt projection failed"
  fi
  log "REQ $base exit=$ec -> $out"
  sleep "$COOLDOWN"                            # throttle to avoid tight cross-post loops
done
log "DRAIN STOPPED agent=$AGENT (stop=$([[ -f $STOP ]] && echo local)$([[ -f $GSTOP ]] && echo +global))"
rm -f "$PIDF"
