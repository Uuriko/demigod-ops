#!/usr/bin/env bash
# Apply Demigod laptop sysctl (swappiness, dirty, inotify). Tries passwordless sudo.
set -euo pipefail
if [[ $# -gt 0 ]]; then
  echo "dg-sysctl-apply: unknown argument $1 — try: bin/dg-sysctl-apply  (no flags)" >&2
  exit 2
fi

CONF_BODY='# Demigod laptop — agent workflows (62GB RAM Oryx)
# Generated by dg-sysctl-apply
vm.swappiness = 20
vm.dirty_ratio = 20
vm.dirty_background_ratio = 5
fs.inotify.max_user_watches = 524288
'

SYS_PATH="/etc/sysctl.d/99-demigod-laptop.conf"
USER_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/sysctl-user/99-demigod-laptop.conf"
mkdir -p "$(dirname "$USER_PATH")"
printf '%s' "$CONF_BODY" >"$USER_PATH"

echo "wrote $USER_PATH"

apply_runtime() {
  # Best-effort without root for writable knobs
  for kv in \
    "vm.swappiness=20" \
    "vm.dirty_ratio=20" \
    "vm.dirty_background_ratio=5" \
    "fs.inotify.max_user_watches=524288"; do
    key="${kv%%=*}"
    val="${kv#*=}"
    path="/proc/sys/${key//./\/}"
    if [[ -w "$path" ]]; then
      echo "$val" >"$path" && echo "runtime $key=$val"
    fi
  done
}

if sudo -n true 2>/dev/null; then
  printf '%s' "$CONF_BODY" | sudo -n tee "$SYS_PATH" >/dev/null
  sudo -n sysctl --system >/dev/null 2>&1 || sudo -n sysctl -p "$SYS_PATH" 2>/dev/null || true
  echo "installed $SYS_PATH (sudo -n)"
else
  echo "No passwordless sudo. To persist system-wide, run:"
  printf "  printf '%%s' %q | sudo tee %q >/dev/null\n" "$CONF_BODY" "$SYS_PATH"
  echo "  sudo sysctl -p $SYS_PATH"
fi

apply_runtime

echo "--- current ---"
sysctl vm.swappiness vm.dirty_ratio vm.dirty_background_ratio fs.inotify.max_user_watches 2>/dev/null || true
