#!/usr/bin/env bash
# Regular Codex swarm assist for Demigod multi-agent coord.
#
#   bin/dg-codex-swarm once          # one assist wave (default)
#   bin/dg-codex-swarm once --full   # 3 parallel roles (workflow/comms/patches)
#   bin/dg-codex-swarm status
#   bin/dg-codex-swarm start         # loop (or use systemd timer)
#   bin/dg-codex-swarm stop
#   bin/dg-codex-swarm apply-hint    # print top findings for agents
#
# Outputs → /tmp/dg-busy/swarm/
#   latest.md · SYNTHESIS.md · swarm-last.json · assist-run.log
# Digest picks up swarm-last.json via bin/dg-agent-coord brief.
#
# Defaults: single "assist" codex (cheap). --full = 3 parallel reviews.
# Interval loop: CODEX_SWARM_SEC=900 (15m). No auto-DM / no game / no foot thrash.
set -euo pipefail
ROOT="${DEMIGOD_ROOT:-$HOME}"
BUSY="${DEMIGOD_BUSY:-/tmp/dg-busy}"
DIR="$BUSY/swarm"
COORD="$BUSY/coord"
LOG="$DIR/assist-run.log"
PIDF="$DIR/assist.pid"
STOP="$DIR/assist.STOP"
LAST="$DIR/swarm-last.json"
LATEST="$DIR/latest.md"
LATEST_CANDIDATE="$DIR/latest.candidate.md"
SYN="$DIR/SYNTHESIS.md"
export PATH="${HOME}/.local/bin:${HOME}/bin:${HOME}/.nvm/versions/node/v24.17.0/bin:/usr/bin:/bin:${PATH}"
cd "$ROOT"
mkdir -p "$DIR" "$COORD"

INTERVAL="${CODEX_SWARM_SEC:-900}"
TIMEOUT="${CODEX_SWARM_TIMEOUT:-360}"

log() { echo "[$(date -Iseconds)] $*" | tee -a "$LOG" >/dev/null; echo "[$(date -Iseconds)] $*"; }

publish_latest() {
  [[ -s "$1" ]] || return 1
  sed -n '1,20p' "$1" >"$LATEST_CANDIDATE"
  mv "$LATEST_CANDIDATE" "$LATEST"
}

alive() {
  [[ -f "$PIDF" ]] || return 1
  local p; p=$(tr -d ' \n' <"$PIDF" || true)
  [[ -n "${p:-}" ]] && kill -0 "$p" 2>/dev/null
}

write_last() {
  # $1 ok 0/1  $2 mode  $3 note
  python3 - <<PY
import json, datetime
from pathlib import Path
p=Path("$LAST")
ok=bool(int("$1"))
mode="$2"
note="""$3"""
files=[]
for name in ("latest.md","SYNTHESIS.md","codex-workflow.md","codex-comms.md","codex-patches.md","assist.md"):
  fp=Path("$DIR")/name
  if fp.exists() and fp.stat().st_size>20:
    files.append(name)
p.write_text(json.dumps({
  "schema":"demigod.codex-swarm/1",
  "ok": ok,
  "at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
  "mode": mode,
  "note": note[:400],
  "files": files,
  "dir": "$DIR",
  "hint": "Agents: read /tmp/dg-busy/swarm/latest.md before inventing work; implement top P0 if lane allows.",
}, indent=2)+"\n")
print("swarm-last written ok=", ok)
PY
}

# Merge short swarm blurb into digest if dg-agent-coord available
refresh_coord_digest() {
  if [[ -x "$ROOT/bin/dg-agent-coord" ]]; then
    "$ROOT/bin/dg-agent-coord" brief >/dev/null 2>&1 || true
  fi
  # append swarm pointer into CLAUDE-BRIEF if missing this hour
  if [[ -f "$LAST" && -f "$COORD/CLAUDE-BRIEF.md" ]]; then
    if ! grep -q 'codex-swarm latest' "$COORD/CLAUDE-BRIEF.md" 2>/dev/null; then
      {
        echo ""
        echo "## Codex swarm"
        echo "Read \`/tmp/dg-busy/swarm/latest.md\` + \`swarm-last.json\` for review assists (P0/P1). Prefer implementing those over inventing thrash."
      } >>"$COORD/CLAUDE-BRIEF.md"
    fi
  fi
}

# Codex quota backoff (shared with bin/dg-agent-coord via $COORD/codex.backoff unix until).
codex_backoff_active() {
  local f="$COORD/codex.backoff"
  [[ -f "$f" ]] || return 1
  local until now
  until=$(tr -d ' \n' <"$f" 2>/dev/null || echo 0)
  now=$(date +%s)
  [[ -n "$until" && "$until" =~ ^[0-9]+$ ]] || return 1
  (( now < until ))
}
set_codex_backoff_from_log() {
  # $1 log path — parse "try again at ..." or default 6h on usage-limit lines
  local logf="$1"
  grep -Eqi 'hit your usage limit|usage limit|weekly limit|usage balance exhausted' "$logf" 2>/dev/null || return 1
  local secs
  secs=$(LOGF="$logf" python3 - <<'PY'
import os, re, time, datetime
from pathlib import Path
text = Path(os.environ["LOGF"]).read_text(errors="ignore")
m = re.search(r"try again at\s+(.+?)(?:\.|$|\n)", text, re.I)
if m:
    s = re.sub(r"(\d+)(st|nd|rd|th)", r"\1", m.group(1).strip())
    for fmt in ("%b %d, %Y %I:%M %p", "%B %d, %Y %I:%M %p", "%b %d %Y %I:%M %p"):
        try:
            dt = datetime.datetime.strptime(s, fmt)
            print(max(3600, int(dt.timestamp() - time.time())))
            raise SystemExit
        except ValueError:
            pass
print(21600)
PY
)
  echo $(( $(date +%s) + ${secs:-21600} )) >"$COORD/codex.backoff"
  log "codex backoff set ${secs:-21600}s (quota) → $COORD/codex.backoff"
  return 0
}

run_assist() {
  # Single Codex: review coord+site thrash, write actionable P0 list + optional tiny tools patch hints
  local out="$DIR/assist.md"
  local runlog="$DIR/assist-codex.log"
  if codex_backoff_active; then
    local until; until=$(tr -d ' \n' <"$COORD/codex.backoff")
    log "assist skipped: codex rate-limit backoff until=$until"
    {
      echo "# Codex swarm assist (rate-limit backoff)"
      echo "skipped at $(date -Iseconds)"
      echo
      echo "## Now"
      echo "Codex usage-limited — not re-invoking until backoff expires (\`$until\` unix)."
      echo "See prior assist-codex.log. Agents: do not invent work from this stub."
    } >"$out"
    publish_latest "$out" || true
    write_last 0 "assist" "skipped: codex backoff until=$until"
    refresh_coord_digest
    return 0
  fi
  date -Iseconds >"$DIR/STARTED"
  rm -f "$LATEST_CANDIDATE"
  log "assist start timeout=${TIMEOUT}s"
  set +e
  rm -f "$out"
  timeout "$TIMEOUT" stdbuf -oL -eL codex exec --sandbox read-only --ephemeral --output-last-message "$out" \
"Demigod CODEX SWARM ASSIST (regular). You are the periodic review swarm.

ACTIVE FOCUS (highest priority if file exists):
- /tmp/dg-busy/events-bot/FOCUS.md — Events Bot / SF nights (PRIMARY)
- /tmp/dg-busy/events-bot/EVENTBOT-MASTER-SPEC.md + BRIEF-FOR-AGENTS.md
- demigod-events-bot-agent.mjs, demigod-events-bot-chat.mjs, demigod-events-app.mjs, demigod-events-bot-selftest.mjs
- DEMIGOD-EVENTS.json (SF only; autoSend=false; no fake RSVPs)
- DEMIGOD-LEADS.json · bin/dg funnel status

READ (required):
- /tmp/dg-busy/coord/digest.md, CLAUDE-BRIEF.md, board.json, *-last.json, claims.json
- /tmp/dg-busy/swarm/SYNTHESIS.md (if any) and latest.md (if any)
- bin/dg-agent-coord (lanes), demigod-agent-dashboard.mjs /api/coord lanes
- demigod-foot-core.js header version only (do NOT thrash foot unless P0 bug)

TASK (review only — do not edit or write workspace files, stores, receipts, or messages):
1) List top 5 inefficiencies or bugs RIGHT NOW (P0–P2), concrete file:line or path — prefer Events Bot / SF nights tools.
2) Give an exact minimal patch recipe for the highest-value Events Bot issue.
3) Pick ONE website fix for Claude only if conversion needs it; else skip website and deepen tools P0.
4) Return concise markdown with sections: ## Now ## P0 ## P1 ## For Claude ## For Codex ## For Grok ## Done. The wrapper captures your final response.
No auto-DM. No game. No CDN/publish thrash. Prefer lanes: claude=website, codex=tools, grok=gates." \
    >>"$runlog" 2>&1
  local ec=$?
  set -e
  log "assist codex exit=$ec"
  if [[ ! -f "$out" ]] || [[ ! -s "$out" ]]; then
    # fallback: synthesize from runlog tail
    {
      echo "# Codex swarm assist (fallback)"
      echo "exit=$ec at $(date -Iseconds)"
      echo
      echo "## Now"
      echo "Codex did not write assist.md — see assist-codex.log tail."
      echo
      tail -40 "$runlog" 2>/dev/null || true
    } >"$out"
  fi
  if ! publish_latest "$out"; then
    rm -f "$LATEST_CANDIDATE"
    log "assist rejected: no final response"
    ec=1
  fi
  if [[ ! -f "$SYN" ]]; then
    echo "# Codex swarm SYNTHESIS" >"$SYN"
  fi
  {
    echo ""
    echo "## Assist $(date -u +%Y-%m-%dT%H:%MZ) ec=$ec"
    head -25 "$out"
  } >>"$SYN"
  # keep SYNTHESIS under ~80k
  if [[ $(wc -c <"$SYN") -gt 80000 ]]; then
    { echo "# Codex swarm SYNTHESIS"; tail -c 40000 "$SYN" | sed -n '/^## Assist /,$p'; } >"$SYN.tmp" && mv "$SYN.tmp" "$SYN"
  fi
  # Quota thrash: long backoff so 15m timer does not re-burn tokens until reset.
  if (( ec != 0 )) || [[ ! -s "$out" ]]; then
    set_codex_backoff_from_log "$runlog" || true
  fi
  write_last "$([[ $ec -eq 0 ]] && echo 1 || echo 0)" "assist" "ec=$ec"
  refresh_coord_digest
  # Keep multi-agent diagram fresh after each swarm assist
  if [[ -x "$ROOT/bin/dg-workflow-map" ]]; then
    "$ROOT/bin/dg-workflow-map" update >>"$LOG" 2>&1 || true
  fi
  # Anti-bloat: rotate a research hint into coord for agents
  if [[ -x "$ROOT/bin/dg-anti-bloat" ]]; then
    "$ROOT/bin/dg-anti-bloat" pick --context=auto >>"$LOG" 2>&1 || true
  fi

  # inbox ping only on real assist (not quota fallback stubs)
  if (( ec == 0 )) && ! grep -Eqi 'usage limit|hit your usage limit' "$runlog" 2>/dev/null; then
    printf '{"at":"%s","from":"codex-swarm","msg":"assist ready — read /tmp/dg-busy/swarm/latest.md"}\n' \
      "$(date -Iseconds)" >>"$COORD/inbox.jsonl" 2>/dev/null || true
  fi
  return 0
}

run_full() {
  log "full 3-role swarm start"
  date -Iseconds >"$DIR/STARTED"
  local roles=(workflow comms patches)
  local pids=()
  for role in "${roles[@]}"; do
    (
      timeout "$TIMEOUT" stdbuf -oL -eL codex exec --sandbox read-only --ephemeral --output-last-message "$DIR/codex-${role}.md" \
"Demigod CODEX SWARM ROLE=$role.
Read /tmp/dg-busy/coord/digest.md + CLAUDE-BRIEF + *-last.json + bin/dg-agent-coord.
Return findings only; do not edit or write workspace files, stores, receipts, or messages. The wrapper captures your final response.
workflow=top inefficiencies; comms=lane/claim contract; patches=minimal implementable diffs ranked.
No foot thrash. No auto-DM/game." \
        >>"$DIR/codex-${role}-run.log" 2>&1
    ) &
    pids+=($!)
    echo $! >"$DIR/codex-${role}.pid"
  done
  local ok=1
  for pid in "${pids[@]}"; do
    wait "$pid" || ok=0
  done
  {
    echo "# Full swarm $(date -u +%Y-%m-%dT%H:%MZ)"
    for role in "${roles[@]}"; do
      echo "## $role"
      head -30 "$DIR/codex-${role}.md" 2>/dev/null || echo "(missing)"
      echo
    done
  } >"$LATEST"
  cp -f "$LATEST" "$DIR/assist.md" 2>/dev/null || true
  cat "$LATEST" >>"$SYN" 2>/dev/null || true
  write_last "$ok" "full" "3-role wave"
  refresh_coord_digest
  log "full swarm done ok=$ok"
}

cmd_once() {
  if alive; then
    echo "already running pid=$(cat "$PIDF")"
    exit 0
  fi
  echo $$ >"$PIDF"
  trap 'rm -f "$PIDF"' EXIT
  local mode=assist
  for a in "$@"; do
    case "$a" in
      --full) mode=full ;;
      *)
        echo "dg-codex-swarm: unknown argument $a — try: bin/dg-codex-swarm once [--full]" >&2
        exit 2
        ;;
    esac
  done
  if [[ "$mode" == full ]]; then run_full; else run_assist; fi
  rm -f "$PIDF"
}

cmd_loop() {
  rm -f "$STOP"
  echo $$ >"$PIDF"
  log "loop start interval=${INTERVAL}s"
  while [[ ! -f "$STOP" ]]; do
    run_assist || true
    local s=0
    while (( s < INTERVAL )) && [[ ! -f "$STOP" ]]; do
      sleep 15
      s=$((s+15))
    done
  done
  log "loop stopped"
  rm -f "$PIDF"
}

cmd_status() {
  echo "dir=$DIR"
  echo "running=$(alive && echo yes || echo no) pid=$(cat "$PIDF" 2>/dev/null || echo none)"
  echo "stop=$([[ -f $STOP ]] && echo yes || echo no)"
  if [[ -f "$LAST" ]]; then
    python3 -c "import json;d=json.load(open('$LAST'));print('last ok=',d.get('ok'),'at=',d.get('at'),'mode=',d.get('mode'),'files=',d.get('files'))"
  else
    echo "last=none"
  fi
  ls -la "$DIR"/*.md 2>/dev/null | tail -8 || true
  # age of latest
  if [[ -f "$LATEST" ]]; then
    echo "latest_age_sec=$(( $(date +%s) - $(stat -c %Y "$LATEST") ))"
    head -12 "$LATEST"
  fi
}

cmd_stop() {
  date -Iseconds >"$STOP"
  if alive; then kill "$(cat "$PIDF")" 2>/dev/null || true; fi
  rm -f "$PIDF"
  echo stopped
}

cmd_apply_hint() {
  if [[ -f "$LATEST" ]]; then
    cat "$LATEST"
  elif [[ -f "$SYN" ]]; then
    tail -40 "$SYN"
  else
    echo "no swarm output yet — run: bin/dg-codex-swarm once"
    exit 1
  fi
}

case "${1:-status}" in
  once) shift; cmd_once "$@" ;;
  start|loop)
    if [[ -n "${2:-}" ]]; then
      echo "dg-codex-swarm: unknown argument $2 — try: bin/dg-codex-swarm start" >&2
      exit 2
    fi
    if alive; then echo "already $(cat "$PIDF")"; exit 0; fi
    nohup "$0" _loop >>"$LOG" 2>&1 &
    echo $! >"$PIDF"
    echo "started loop pid=$! interval=${INTERVAL}s"
    ;;
  _loop) cmd_loop ;;
  stop)
    if [[ -n "${2:-}" ]]; then
      echo "dg-codex-swarm: unknown argument $2 — try: bin/dg-codex-swarm stop" >&2
      exit 2
    fi
    cmd_stop
    ;;
  status)
    if [[ -n "${2:-}" ]]; then
      echo "dg-codex-swarm: unknown argument $2 — try: bin/dg-codex-swarm status" >&2
      exit 2
    fi
    cmd_status
    ;;
  apply-hint|hint)
    if [[ -n "${2:-}" ]]; then
      echo "dg-codex-swarm: unknown argument $2 — try: bin/dg-codex-swarm apply-hint" >&2
      exit 2
    fi
    cmd_apply_hint
    ;;
  *)
    echo "usage: $0 once [--full]|start|stop|status|apply-hint"
    exit 2
    ;;
esac
