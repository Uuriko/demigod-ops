#!/usr/bin/env bash
# Keep Demigod automation loops alive.
# Stop watchdog: touch /tmp/dg-busy/funnel-loop.WATCHDOG.STOP
# Stop funnel-loop only: touch /tmp/dg-busy/funnel-loop.STOP
# Stop grok-busy only: touch /tmp/dg-busy/grok-busy.STOP
set -euo pipefail
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      echo "usage: dg-funnel-watchdog  (no flags; STOP files under /tmp/dg-busy/)"
      exit 0
      ;;
    *)
      echo "dg-funnel-watchdog: unknown argument $arg — try: dg-funnel-watchdog" >&2
      exit 2
      ;;
  esac
done
ROOT=/home/potter
BUSY=/tmp/dg-busy
export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.nvm/versions/node/v24.17.0/bin:/usr/bin:/bin:$PATH"
cd "$ROOT"
mkdir -p "$BUSY/funnel-loop" "$BUSY/grok-busy" "$BUSY/swarm"
log(){ echo "[$(date -Iseconds)] $*" >>"$BUSY/funnel-loop/watchdog.log"; }

alive_pidfile() {
  local f="$1"
  local p
  p="$(cat "$f" 2>/dev/null || true)"
  [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null
}

while [[ ! -f "$BUSY/funnel-loop.WATCHDOG.STOP" ]]; do
  # funnel-loop — 30s sleep (user request; was 90s)
  if [[ -f "$BUSY/funnel-loop.STOP" ]]; then
    log "funnel-loop STOP present — not restarting funnel"
  else
    if ! alive_pidfile "$BUSY/funnel-loop/funnel-loop.pid"; then
      log "restart funnel-loop sleep=30s"
      nohup node "$ROOT/demigod-funnel-loop.mjs" run --sleep-sec=30 --max-cycles=0 \
        >>"$BUSY/funnel-loop/funnel-loop.log" 2>>"$BUSY/funnel-loop/funnel-loop.err" &
      echo $! >"$BUSY/funnel-loop/funnel-loop.pid"
    fi
  fi

  # grok-busy — 30s sleep, dual with events-light heal/invite-drain
  if [[ -f "$BUSY/grok-busy.STOP" ]]; then
    log "grok-busy STOP present — not restarting"
  else
    if ! alive_pidfile "$BUSY/grok-busy/grok-busy.pid" && ! alive_pidfile "$BUSY/grok-busy.pid"; then
      log "restart grok-busy sleep=30s"
      nohup node "$ROOT/demigod-grok-busy-loop.mjs" run --sleep-sec=30 --agent-every=2 \
        >>"$BUSY/grok-busy/grok-busy.log" 2>>"$BUSY/grok-busy/stderr.log" &
      echo $! >"$BUSY/grok-busy/grok-busy.pid"
    fi
  fi

  if [[ ! -f "$BUSY/swarm/assist.STOP" ]]; then
    if ! alive_pidfile "$BUSY/swarm/assist.pid"; then
      log "restart codex-swarm loop"
      CODEX_SWARM_SEC=600 "$ROOT/bin/dg-codex-swarm" start >>"$BUSY/funnel-loop/watchdog.log" 2>&1 || true
    fi
  fi

  # keep coord drainers up
  systemctl --user start demigod-agent-coord.service 2>/dev/null || true
  sleep 60
done
log "watchdog stopped"
