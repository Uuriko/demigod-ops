#!/usr/bin/env bash
# dg — Demigod Control Plane CLI (cohesive front door)
#
# Prefer this over inventing one-off paths.
# Subcommands:
#   orient | unify | truth | next-canon | cycle-status | demand | pilot | ship | home | …
#   webflow | matches | review | hygiene | doctor | smoke | freeze | events-test
#   cockpit | usertest | dash | orca | start | tools
#   full-check [--release] | live | live-attest | audit-100 | lock | mime | evidence | craft | ledger | ship-receipt
#   demigod:*  → npm run
# Agents: start with `bin/dg orient`
# Atlas: docs/exchange/DEMIGOD-FULL-HISTORY-AND-TOOL-ATLAS.md
# Registry: node demigod-tools-registry.mjs --md
#
set -euo pipefail
cd /home/potter
export DEMIGOD_ROOT="${DEMIGOD_ROOT:-/home/potter}"

# No args or known control verbs → control plane
if [[ $# -eq 0 ]]; then
  # Interactive palette if fzf exists and tty; else home
  if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
    items=$( {
      echo 'home::node demigod-control.mjs home'
      echo 'status::node demigod-control.mjs status --json'
      echo 'next::node demigod-control.mjs next'
      echo 'webflow-doctor::node demigod-webflow.mjs doctor'
      echo 'hygiene-prune::node demigod-laptop-hygiene.mjs --prune'
      echo 'ponytail::node demigod-ponytail.mjs status'
      echo 'review::node demigod-review.mjs'
      echo 'matches::node demigod-match-review.mjs --json'
      echo 'dash::bin/dg-dash'
      echo 'linux-status::bin/dg-linux-config status'
      echo 'tmux-cockpit::dg-tmux-cockpit'
      echo 'truth::node demigod-truth.mjs'
      echo 'workspace-cheat::dg-workspace cheat'
      echo 'workspace-webflow::dg-workspace webflow'
      echo 'workspace-ops::dg-workspace ops'
      echo 'busy-rotate::dg-busy-rotate'
      echo 'start::bin/dg-start'
      npm run 2>/dev/null | grep -oE 'demigod:[a-z0-9:-]+' \
        | grep -vE ':(cycle|receipt:mint|sms:sim|ghost:push)$' \
        | sed 's/^/npm run /' \
        | head -80
    } | sort -u )
    choice=$(echo "$items" | fzf --prompt='demigod> ' --height=50% --reverse --tiebreak=index || true)
    [ -z "${choice:-}" ] && exit 0
    if [[ "$choice" == *::* ]]; then
      eval "${choice#*::}"
    else
      eval "$choice"
    fi
    exit $?
  fi
  exec node demigod-control.mjs home
fi

# Known subcommands → control plane / modules
case "$1" in
  home|status|next|plane|modules|help|--help|-h)
    exec node demigod-control.mjs "$@"
    ;;
  webflow|wf|matches|match|pairs|inbox|review|hygiene|ponytail|doctor|smoke|freeze|cockpit|usertest|dash)
    exec node demigod-control.mjs "$@"
    ;;
  linux|laptop|sysctl|power)
    shift
    exec bin/dg-linux-config "${@:-status}"
    ;;
  tmux|tmux-cockpit)
    shift
    exec dg-tmux-cockpit "${@:-attach}"
    ;;
  agent-run)
    shift
    exec dg-agent-run "$@"
    ;;
  notify)
    shift
    exec dg-notify "$@"
    ;;
  workspace|ws|cosmic)
    shift
    exec dg-workspace "${@:-cheat}"
    ;;
  busy-rotate)
    shift
    exec dg-busy-rotate "$@"
    ;;
  coord|agent-coord)
    shift
    exec bin/dg-agent-coord "${@:-status}"
    ;;
  orca)
    shift
    exec bin/dg-orca "$@"
    ;;
  free-ops|freeops|email-check|uptime-smoke)
    shift
    exec bin/dg-free-ops "$@"
    ;;
  full-check|fullcheck|check-all)
    shift
    exec node demigod-full-check.mjs "$@"
    ;;
  check)
    shift
    exec node demigod-check.mjs "$@"
    ;;
  done|handoff)
    shift
    # Structured: bin/dg handoff --from x --done "…" --next "…" --blocked "…"
    # Legacy: bin/dg handoff "note text"
    if [[ "${1:-}" == --* ]] || [[ "${1:-}" == "" ]]; then
      exec node demigod-handoff.mjs "$@"
    fi
    note="${1:-}"; shift || true
    next="${1:-}"
    exec node demigod-handoff.mjs --from "${USER:-agent}" --done "$note" --next "$next"
    ;;

  live|live-doctor)
    shift
    exec node demigod-truth.mjs "$@"
    ;;
  truth)
    shift
    exec node demigod-truth.mjs "$@"
    ;;
  lock|foot-lock)
    shift
    exec node demigod-foot-lock.mjs "$@"
    ;;
  mime|route-mime)
    shift
    exec node demigod-route-mime.mjs "$@"
    ;;
  review-bug)
    shift
    exec node demigod-review.mjs --bug --gates "$@"
    ;;
  review-fix)
    shift
    exec node demigod-review.mjs --fix --dry-run "$@"
    ;;
  review-self|review-meta)
    shift
    exec node demigod-review.mjs --include-meta --bug --full --stats \
      --files demigod-review.mjs demigod-review-lib.mjs demigod-review-rules.mjs \
      demigod-review-fix.mjs demigod-review-gates.mjs demigod-review-llm.mjs \
      demigod-review-selftest.mjs bin/dg-review "$@"
    ;;
  ship-prep|prep-ship)
    shift
    exec node demigod-ship-prep.mjs "$@"
    ;;
  ship-help|shiphelp)
    shift
    exec node demigod-ship-help.mjs "$@"
    ;;
  ship)
    shift
    exec node demigod-ship.mjs "$@"
    ;;
  demand|gtm)
    shift
    exec node demigod-demand.mjs "$@"
    ;;
  funnel|leads-funnel)
    shift
    exec node demigod-funnel.mjs "$@"
    ;;
  funnel-loop)
    shift
    exec node demigod-funnel-loop.mjs "$@"
    ;;
  events-outbox)
    shift
    exec bin/dg-events-outbox "$@"
    ;;
  events-invite-drain|invite-drain)
    shift
    exec node demigod-events-invite-drain.mjs "$@"
    ;;
  events-online)
    shift
    exec node demigod-events-online.mjs "${@:-status}"
    ;;
  events-reconcile)
    shift
    exec node demigod-events-reconcile.mjs "$@"
    ;;
  events-test)
    shift
    events_tests=(
      demigod-events-app-policy-selftest.mjs
      demigod-events-lifecycle-readiness.test.mjs
      demigod-events-audience-brief.test.mjs
      demigod-events-outbox-scope.test.mjs
      demigod-events-public-invite.test.mjs
      demigod-events-publish-config.test.mjs
      demigod-events-online-config.test.mjs
      demigod-events-venue-ranking.test.mjs
      demigod-dashboard-events-native-invite.test.mjs
      demigod-chatroom.test.mjs
    )
    if [[ "${1:-}" == "fast" ]]; then
      for events_test in "${events_tests[@]}"; do node --test "$events_test" || exit; done
      exec env DEMIGOD_EVENTS_BOT_MOCK=1 node demigod-events-bot-selftest.mjs
    fi
    node --test --test-concurrency=1 "${events_tests[@]}" "$@"
    exec env DEMIGOD_EVENTS_BOT_MOCK=1 node demigod-events-bot-selftest.mjs
    ;;
  lead-collect|leads-collect)
    shift
    exec node demigod-lead-collect.mjs "$@"
    ;;
  lead-pipeline)
    shift
    [[ "${1:-}" == "status" ]] && set -- tick --stage=status "${@:2}"
    exec node demigod-lead-pipeline.mjs "$@"
    ;;
  never-stop)
    shift
    exec node demigod-never-stop-loop.mjs "$@"
    ;;
  codex-swarm)
    shift
    exec bin/dg-codex-swarm "$@"
    ;;
  grok-loop|grok-busy)
    shift
    exec node demigod-grok-busy-loop.mjs "$@"
    ;;
  pilot|inbound)
    shift
    exec node demigod-pilot-inbound.mjs "$@"
    ;;
  referrals|referral)
    shift
    exec node demigod-referrals.mjs "${@:-status}"
    ;;
  next-canon|canon-next)
    shift
    exec node demigod-next.mjs "$@"
    ;;
  cycle-status|cycle)
    shift
    exec node demigod-cycle-status.mjs "$@"
    ;;
  evidence)
    shift
    exec node demigod-evidence.mjs "$@"
    ;;
  craft|craft-log)
    shift
    exec node demigod-craft-log.mjs "$@"
    ;;
  lock-who|who-lock)
    shift
    exec node demigod-foot-lock.mjs who "$@"
    ;;
  live-attest|attest-live|attest)
    shift
    exec node demigod-live-attest.mjs "$@"
    ;;
  audit-100|audit100|full-audit)
    shift
    exec node demigod-audit-100.mjs "$@"
    ;;
  ship-receipt|receipt)
    shift
    exec node demigod-ship-receipt.mjs "$@"
    ;;
  ledger|truth-delta)
    shift
    if [[ "${1:-}" == "" || "${1:-}" == "--json" ]]; then
      exec node demigod-version-ledger.mjs delta
    fi
    exec node demigod-version-ledger.mjs "$@"
    ;;
  tools|registry)
    shift
    exec node demigod-tools-registry.mjs "$@"
    ;;
  unify|cohesion)
    shift
    exec node demigod-unify.mjs "$@"
    ;;
  orient|session-start)
    shift
    exec node demigod-orient.mjs "$@"
    ;;
  start)
    exec bin/dg-start
    ;;
  *)
    # Fallback: if looks like demigod:script
    if [[ "$1" == demigod:* ]]; then
      exec npm run "$1" -- "${@:2}"
    fi
    # Unknown verb → control help + try as webflow subcommand hint
    echo "Unknown: $1 — try: bin/dg orient | cycle-status | demand | pilot | truth | home | tools" >&2
    node demigod-control.mjs help
    exit 2
    ;;
esac
