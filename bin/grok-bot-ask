#!/usr/bin/env bash
# dg-bus adapter for Grok Bot (async). Does NOT call a model CLI.
# Tasks are queued for the Grok Bot agent to pick up from the inbox file.
set -euo pipefail
BUSY="${DEMIGOD_BUSY:-/tmp/dg-busy}"
INBOX_DIR="${DEMIGOD_ROOT:-/home/potter}/slop-agent-inbox"
LOG="$BUSY/grok-bot-ask.log"
QUEUE_FILE="$INBOX_DIR/bus-inbox.jsonl"
mkdir -p "$BUSY" "$INBOX_DIR"
ts="$(date -Iseconds)"
if [[ $# -gt 0 ]]; then
  prompt="$*"
else
  prompt="$(cat)"
fi
id="${ts//[:.+]/}-${RANDOM}"
# one JSON line
python3 - "$QUEUE_FILE" "$id" "$ts" "$prompt" <<'PY'
import json,sys
path, id_, ts, prompt = sys.argv[1:5]
row = {"id": id_, "queuedAt": ts, "status": "queued", "spec": prompt}
with open(path, "a", encoding="utf-8") as f:
    f.write(json.dumps(row, ensure_ascii=False) + "\n")
print(f"ACK: queued for Grok Bot id={id_} (file {path}). Grok Bot polls this inbox; not a sync model call.")
PY
printf '[%s] queued id=%s bytes=%d\n' "$ts" "$id" "${#prompt}" >>"$LOG"
