#!/usr/bin/env bash
# Regenerate + self-review the multi-agent workflow diagram.
#
#   bin/dg-workflow-map update     # rewrite diagram from live state + review
#   bin/dg-workflow-map review     # review only (no rewrite if fresh)
#   bin/dg-workflow-map status
#
# Outputs:
#   docs/DEMIGOD-MULTI-AGENT-COORD-DIAGRAM.md
#   DEMIGOD-MULTI-AGENT-COORD-DIAGRAM.md (root copy)
#   /tmp/dg-busy/coord/workflow-map-last.json
#   /tmp/dg-busy/coord/workflow-map-review.md
#
# Occasional: demigod-workflow-map.timer (every 2h) or call from codex-swarm.
set -euo pipefail
ROOT="${DEMIGOD_ROOT:-$HOME}"
BUSY="${DEMIGOD_BUSY:-/tmp/dg-busy}"
COORD="$BUSY/coord"
DOC="$ROOT/docs/DEMIGOD-MULTI-AGENT-COORD-DIAGRAM.md"
DOC2="$ROOT/DEMIGOD-MULTI-AGENT-COORD-DIAGRAM.md"
LAST="$COORD/workflow-map-last.json"
REVIEW="$COORD/workflow-map-review.md"
export PATH="${HOME}/.local/bin:${HOME}/bin:/usr/bin:/bin:${PATH}"
cd "$ROOT"
mkdir -p "$COORD" "$ROOT/docs"

cmd="${1:-update}"

python3 - "$cmd" <<'PY'
import json, os, re, subprocess, sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(os.environ.get("DEMIGOD_ROOT", Path.home()))
BUSY = Path(os.environ.get("DEMIGOD_BUSY", "/tmp/dg-busy"))
COORD = BUSY / "coord"
DOC = ROOT / "docs" / "DEMIGOD-MULTI-AGENT-COORD-DIAGRAM.md"
DOC2 = ROOT / "DEMIGOD-MULTI-AGENT-COORD-DIAGRAM.md"
LAST = COORD / "workflow-map-last.json"
REVIEW = COORD / "workflow-map-review.md"
cmd = sys.argv[1] if len(sys.argv) > 1 else "update"
now = datetime.now(timezone.utc)
now_s = now.strftime("%Y-%m-%dT%H:%M:%SZ")
day = now.strftime("%Y-%m-%d")


def sh(args, timeout=8):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout, cwd=str(ROOT))
        return (r.stdout or "") + (r.stderr or "")
    except Exception as e:
        return str(e)


def unit_active(name):
    out = sh(["systemctl", "--user", "is-active", name]).strip().splitlines()
    state = out[-1] if out else "unknown"
    return True if state == "active" else False if state == "inactive" else None


def unit_label(state, off="off"):
    return "active" if state is True else off if state is False else "unknown"


def load_json(p):
    try:
        return json.loads(Path(p).read_text())
    except Exception:
        return None


def load_json_from_text(text):
    try:
        return json.loads(text)
    except Exception:
        return None


# --- live snapshot ---
foot = "?"
try:
    t = (ROOT / "demigod-foot-core.js").read_text(errors="replace")
    m = re.search(r"__dgFootVer=['\"](\d+)['\"]", t)
    if m:
        foot = "v" + m.group(1)
except Exception:
    pass

board = load_json(COORD / "board.json") or {}
claims = load_json(COORD / "claims.json") or {}
swarm_last = load_json(BUSY / "swarm" / "swarm-last.json") or {}
chat = load_json(COORD / "chat-last.json") or {}
claude = load_json(COORD / "claude-last.json") or {}
codex = load_json(COORD / "codex-last.json") or {}
grok = load_json(COORD / "grok-last.json") or {}

units = {
    "demigod-agent-coord.service": unit_active("demigod-agent-coord.service"),
    "demigod-term-pump.service": unit_active("demigod-term-pump.service"),
    "demigod-codex-swarm.timer": unit_active("demigod-codex-swarm.timer"),
    "demigod-dash.service": unit_active("demigod-dash.service"),
    "demigod-agent-coord-watchdog.timer": unit_active("demigod-agent-coord-watchdog.timer"),
    "demigod-workflow-map.timer": unit_active("demigod-workflow-map.timer"),
}

# timeouts from unit files if present
tick, t_claude, t_codex, t_grok, term_pump = "30", "300", "240", "240", "300"
try:
    u = (Path.home() / ".config/systemd/user/demigod-agent-coord.service").read_text()
    for key, var in [
        ("COORD_TICK_SEC", "tick"),
        ("COORD_CLAUDE_TIMEOUT", "t_claude"),
        ("COORD_CODEX_TIMEOUT", "t_codex"),
        ("COORD_GROK_TIMEOUT", "t_grok"),
    ]:
        m = re.search(rf"Environment={key}=(\d+)", u)
        if m:
            locals()[var] if False else None
            if key == "COORD_TICK_SEC":
                tick = m.group(1)
            elif key == "COORD_CLAUDE_TIMEOUT":
                t_claude = m.group(1)
            elif key == "COORD_CODEX_TIMEOUT":
                t_codex = m.group(1)
            elif key == "COORD_GROK_TIMEOUT":
                t_grok = m.group(1)
except Exception:
    pass
try:
    u = (Path.home() / ".config/systemd/user/demigod-term-pump.service").read_text()
    m = re.search(r"TERM_PUMP_SEC=(\d+)", u)
    if m:
        term_pump = m.group(1)
except Exception:
    pass

cycle = board.get("cycle", "?")
holds = claims.get("holds") or {}
tracks = board.get("tracks") or {}

# coord source markers
coord_src = (ROOT / "bin/dg-agent-coord").read_text(errors="replace") if (ROOT / "bin/dg-agent-coord").exists() else ""
has_wave = "spawn_wave" in coord_src
has_mtime = "receipt_mtime" in coord_src or "pre_ns" in coord_src
has_stale_avoid = "staleSuccessAvoided" in coord_src

# --- review findings ---
problems = []
improvements = []

# Consume latest unit-classification receipt (if any) so intentionally-absent
# review planes are not reported as problems. Failed units still surface.
_unit_class = {}
try:
    _cls_files = sorted(BUSY.glob("workflow-units-classify-*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
    if _cls_files:
        _unit_class = (load_json(_cls_files[0]) or {}).get("units") or {}
except Exception:
    _unit_class = {}


def unit_intentionally_absent(name):
    meta = _unit_class.get(name) or {}
    return meta.get("role") == "intentionally_absent"


def agent_backoff_until(agent: str):
    """Unix epoch from /tmp/dg-busy/coord/{agent}.backoff when still in the future."""
    p = COORD / f"{agent}.backoff"
    try:
        raw = p.read_text(encoding="utf8").strip().split()[0]
        until = int(float(raw))
        return until if until > now.timestamp() else None
    except Exception:
        return None


if not has_wave:
    problems.append("P1: dg-agent-coord missing spawn_wave — diagram claims shared cycle")
if not has_mtime or not has_stale_avoid:
    problems.append("P1: honest mtime-scoped receipts not in coord source — diagram overstates fix")
if units.get("demigod-agent-coord.service") is False:
    problems.append("P0: agent-coord service inactive while diagram assumes nonstop workers")
codex_backoff_until = agent_backoff_until("codex")
if units.get("demigod-codex-swarm.timer") is False and not unit_intentionally_absent("demigod-codex-swarm.timer"):
    if codex_backoff_until:
        # Active backoff is intentional — do not P2 thrash "enable swarm" during pause.
        until_s = datetime.fromtimestamp(codex_backoff_until, timezone.utc).strftime("%Y-%m-%dT%H:%MZ")
        improvements.append(f"codex-swarm timer off during codex backoff until {until_s} (expected)")
    else:
        problems.append("P2: codex-swarm timer inactive — review plane may be stale")
if units.get("demigod-term-pump.service") is False and not unit_intentionally_absent("demigod-term-pump.service"):
    problems.append("P2: term-pump inactive — interactive plane offline")
# Surface classified failures (core/optional) even when inactive-plane noise is suppressed
for _uname, _meta in _unit_class.items():
    if not isinstance(_meta, dict):
        continue
    if _meta.get("role") == "intentionally_absent":
        continue
    if _meta.get("ok") is False and _meta.get("role") == "core_spine":
        problems.append(f"P1: core spine unit not ok — {_uname} state={_meta.get('state')}")
if not (BUSY / "swarm" / "latest.md").exists():
    problems.append("P2: no swarm/latest.md yet — agents have no review assist file")
if foot == "?":
    problems.append("P1: could not read foot version from demigod-foot-core.js")
# Post-write checks use the generated md content (applied below); pre-check only missing file
if not DOC.exists() and cmd == "review":
    problems.append("P0: diagram file missing — run bin/dg-workflow-map update")

# consistency: diskReady via curl optional
api_ok = False
api_unobservable = False
try:
    import urllib.request
    with urllib.request.urlopen("http://127.0.0.1:9878/api/coord", timeout=3) as r:
        api_ok = r.status == 200
except Exception:
    fallback = load_json_from_text(sh([str(ROOT / "bin" / "dg-dash"), "coord"], timeout=4))
    api_unobservable = bool(fallback and fallback.get("ok"))
    if not api_unobservable:
        problems.append("P2: dashboard unavailable — recovery: bin/dg-dash")

# agent last did one-liners
def did_line(name, d):
    if not d:
        return f"- **{name}**: (no receipt)"
    did = d.get("did") or []
    if isinstance(did, str):
        did = [did]
    first = str(did[0])[:100] if did else "(empty)"
    return f"- **{name}** ok={d.get('ok')} lane={d.get('lane')}: {first}"

# --- write diagram ---
md = f"""# Demigod — multi-agent coordination workflow

**Updated:** {day} · auto via `bin/dg-workflow-map` · review: `/tmp/dg-busy/coord/workflow-map-review.md`  
**Dash:** Map tab → **Agents / coord** · API `/api/maps/agents` · live strip `GET /api/coord`

This is the **current** multi-agent operating model (Claude Code · Codex · Grok · chat · swarm).

---

## Live snapshot ({now_s})

| Field | Value |
|-------|-------|
| Disk foot | **{foot}** |
| Board cycle | **{cycle}** |
| Claims holds | `{json.dumps(holds) if holds else "{{}}"}` |
| Swarm last | {swarm_last.get("at") or "—"} ok={swarm_last.get("ok")} |
| Coord service | {unit_label(units.get("demigod-agent-coord.service"), "INACTIVE")} |
| Term-pump | {unit_label(units.get("demigod-term-pump.service"))} · every {term_pump}s |
| Codex swarm timer | {unit_label(units.get("demigod-codex-swarm.timer"))} · ~15m |
| Coord watchdog | {unit_label(units.get("demigod-agent-coord-watchdog.timer"))} |
| Dash :9878 /api/coord | {"ok" if api_ok else "unobservable (fresh host heartbeat)" if api_unobservable else "down"} |
| Tick / timeouts | tick={tick}s · claude={t_claude}s · codex={t_codex}s · grok={t_grok}s |
| spawn_wave + honest receipts | wave={has_wave} · mtime receipts={has_mtime} |

**Recent agent did**

{did_line("claude", claude)}
{did_line("codex", codex)}
{did_line("grok", grok)}
{did_line("chat", chat)}

---

## 1. Big picture (execution planes)

| Plane | What | How often | Writes |
|-------|------|-----------|--------|
| **Headless coord** | `bin/dg-agent-coord` + **watchdog** timer | tick ~{tick}s; `spawn_wave` when idle | `*-last.json`, board, digest |
| **Interactive term** | tmux `agents` + `bin/dg-term-pump` | every {term_pump}s; **skip if headless busy** | `term-*-last.json` |
| **Chat Grok** | interactive chat + **90s** scheduler + **45s** heartbeat | turn / schedule | `chat-last.json`, foot/head (lanes) |
| **Codex swarm assist** | `bin/dg-codex-swarm` + **15m** timer | review P0/P1 | `/tmp/dg-busy/swarm/*` |
| **Dashboard** | `:9878` Map · Home coord strip · `/api/coord` | on demand | display only (tools lane edits dash code) |

Headless **Claude / Codex / Grok** are primary continuous workers. Term + chat are backup / visible. Swarm **reviews** into `latest.md` (does not thrash foot).

```mermaid
flowchart TB
  subgraph Humans["Human / laptop"]
    U[You · Grok chat · Designer Publish]
  end

  subgraph Dash["Dashboard :9878"]
    UI[Home · Map/agents · Swarm · Ship]
    API["/api/coord · /api/maps/agents · /api/control"]
  end

  subgraph Coord["demigod-agent-coord + watchdog"]
    SUP["Supervisor spawn_wave · shared cycle · mtime receipts"]
    CL["Claude CLI · LANE=website"]
    CX["Codex CLI · LANE=tools"]
    GK["Grok CLI · LANE=gates"]
    SUP --> CL & CX & GK
  end

  subgraph Term["tmux agents"]
    TC[pane 0.0 Claude TUI]
    TG[pane 0.1 Grok TUI]
    PUMP["dg-term-pump skip if headless busy"]
    PUMP -.->|type when idle| TC & TG
  end

  subgraph Swarm["Codex swarm 15m"]
    SW[dg-codex-swarm once]
    LATEST["swarm/latest.md"]
    SW --> LATEST
  end

  subgraph Disk["Shared truth"]
    DIG["coord/digest.md + CLAUDE-BRIEF.md"]
    REC["claude/codex/grok/chat/term-*-last.json"]
    BOARD["board.json · claims.json · board.lock"]
    SOR["foot-core · head-minimal · blog-posts.json"]
    MAP["docs/DEMIGOD-MULTI-AGENT-COORD-DIAGRAM.md"]
  end

  U --> UI
  UI --> API
  API --> DIG & REC & BOARD & MAP
  LATEST --> DIG
  CL & CX & GK --> REC
  CL --> SOR
  CX --> Dash
  GK --> DIG
  SUP --> BOARD
  TC & TG --> REC
  U -->|dg-lock + intentional ship| SOR
  MAP -.->|bin/dg-workflow-map| DIG
```

---

## 2. Lanes (anti-thrash)

| Agent | Owns | Forbidden | Foot |
|-------|------|-----------|------|
| **Claude** | foot-core, head-minimal, blog-posts.json | dash thrash, auto-DM | `DG_LOCK_OWNER=… bin/dg-lock` |
| **Codex** | agent-dashboard*, webflow helpers, tools | **foot-core** | never |
| **Grok** | verify, loop-state, board honesty, light head/blog | foot without lock | if claim free |
| **Chat / term** | one digest backlog item | redo peer `did` | same as lane |

```mermaid
flowchart LR
  subgraph Website["Website SoR"]
    F[foot-core.js]
    H[head-minimal.html]
    B[blog-posts.json]
  end
  subgraph Tools["Dash / tools"]
    D[dashboard mjs+ui]
    W[webflow helpers]
    V[verify + loop-state]
  end
  CL[Claude] --> F & H & B
  CX[Codex] --> D & W
  GK[Grok] --> V
  GK -.->|light| H & B
  LOCK[(bin/dg-lock)]
  CL --> LOCK --> F
```

---

## 3. Supervisor tick (shared cycle + honest receipts)

1. `spawn_wave`: any role idle (not backoff) → **one** `bump_cycle` under `board.lock` flock.
2. Same **cycle id** to every agent spawned in that wave.
3. Snapshot receipt **mtime** before spawn.
4. On exit: keep prior `ok:true` **only if** mtime advanced; else honest `ok:false` (`staleSuccessAvoided`).
5. Fail/timeout → backoff Claude 90s / Codex·Grok 60s.
6. `refresh_digest` rebuilds digest + brief (+ swarm pointer + claims).

```mermaid
sequenceDiagram
  participant S as Supervisor
  participant B as board.json
  participant C as Claude
  participant X as Codex
  participant G as Grok
  participant R as last.json

  S->>B: bump_cycle once flock
  par website
    S->>C: cycle N LANE=website
    C->>R: claude-last
  and tools
    S->>X: cycle N LANE=tools
    X->>R: codex-last
  and gates
    S->>G: cycle N LANE=gates
    G->>R: grok-last
  end
  S->>S: mtime-scoped write_exit_receipt
  S->>S: refresh digest.md
```

---

## 4. Shared filesystem spine

```
/tmp/dg-busy/coord/
  CLAUDE-BRIEF.md · digest.md · board.json · claims.json · board.lock
  claude|codex|grok|chat|term-*-last.json · inbox.jsonl
  workflow-map-last.json · workflow-map-review.md

/tmp/dg-busy/swarm/
  latest.md · assist.md · SYNTHESIS.md · swarm-last.json

/tmp/dg-busy/foot-lock.json   # bin/dg-lock
```

**Dogfood:** `GET /api/coord` → lanes, claims, digest, swarm, diskReady, footNotes.

---

## 5. Website ship path (intentional only)

```mermaid
flowchart LR
  DISK[Disk SoR] --> VER[verify:source]
  VER --> LOCK[dg-lock]
  LOCK --> CDN[foot CDN]
  CDN --> CM6[CM6 paste + Publish]
  CM6 --> LIVE[trydemigod.com]
  LIVE --> DOC[live doctor]
```

No auto-DM · no game · no thrash publish. Disk may lead live until deliberate ship.

---

## 6. Commands

| Action | Command |
|--------|---------|
| Coord status | `bin/dg-agent-coord status` |
| Digest | `bin/dg-agent-coord brief` |
| Restart coord | `systemctl --user restart demigod-agent-coord` |
| Term type | `bin/dg-term-type claude/grok "…"` |
| Codex swarm | `bin/dg-codex-swarm once` / `status` |
| **Refresh this diagram** | `bin/dg-workflow-map update` |
| Foot lock | `DG_LOCK_OWNER=me bin/dg-lock …` |
| Verify | `npm run demigod:verify:source` |

**systemd user:** coord · term-pump · codex-swarm.timer · workflow-map.timer · dash · coord-watchdog.timer

---

## 7. Agent turn checklist

1. Read `digest.md` + `swarm/latest.md` if present.
2. Respect **lane** + **claims** + **foot lock**.
3. 1–2 Ponytail wins; do not redo peer `did`.
4. Write `*-last.json` with `lane` + `cycle`.
5. `verify:source` if foot/head; retarget loop-state foot ver.

---

## 8. Last auto-review ({now_s})

**Problems**
"""
if problems:
    for p in problems:
        md += f"\n- {p}"
else:
    md += "\n- (none)"

md += "\n\n**Improvements applied / suggested**\n"
for i in improvements:
    md += f"\n- {i}"

md += """

---

## 9. Related maps

- Total workflow — `/api/maps/workflow`
- Website architecture — `/api/maps/website`
- Resources — `/api/maps/resources`
- **This map** — `/api/maps/agents` (lanes SoR)
"""

# Post-generate self-review of content we just built
if "Live snapshot" not in md:
    problems.append("P1: generated md missing Live snapshot")
if "watchdog" not in md.lower():
    problems.append("P2: generated md missing watchdog")
if "45s" not in md and "90s" not in md:
    problems.append("P2: chat heartbeat/scheduler not documented")
mc = md.count("```mermaid")
if mc < 3:
    problems.append(f"P1: only {mc} mermaid blocks (want >=3)")
else:
    improvements.append(f"mermaid diagrams ok ({mc})")
if f"**{foot}**" not in md and foot != "?":
    problems.append("P1: live foot ver not in snapshot table")
if not problems:
    improvements.append("No structural P0/P1 — Live snapshot + lanes + swarm + timers consistent")

def write_receipt(mode):
    REVIEW.write_text(
        f"# workflow-map review {now_s}\n\n## Problems\n"
        + ("\n".join(f"- {p}" for p in problems) or "- none")
        + "\n\n## Improvements\n"
        + ("\n".join(f"- {i}" for i in improvements) or "- none")
        + f"\n\nMode: {mode}. Diagram path: {DOC}\n"
    )
    LAST.write_text(
        json.dumps(
            {
                "schema": "demigod.workflow-map/1",
                "ok": len([p for p in problems if str(p).startswith("P0")]) == 0,
                "at": now_s,
                "mode": mode,
                "foot": foot,
                "cycle": cycle,
                "bytes": len(md) if mode == "update" else (DOC.stat().st_size if DOC.exists() else 0),
                "problems": problems,
                "improvements": improvements,
                "units": units,
                "reachability": {"/api/coord": api_ok},
                "coordAvailable": api_ok or api_unobservable,
                "coordSource": "api" if api_ok else "coord-files" if api_unobservable else "down",
                "reachabilityObservedAt": now_s,
                "path": str(DOC),
                "mermaid": mc if mode == "update" else (DOC.read_text().count("```mermaid") if DOC.exists() else 0),
            },
            indent=2,
        )
        + "\n"
    )

if cmd == "status":
    print(f"doc={DOC.exists()} foot={foot} cycle={cycle} problems={len(problems)}")
    for p in problems:
        print("!", p)
    if LAST.exists():
        print(LAST.read_text()[:400])
    sys.exit(0)

if cmd == "review":
    # re-read on-disk diagram for review-only
    if DOC.exists():
        md = DOC.read_text(errors="replace")
        problems = []
        improvements = []
        if "Live snapshot" not in md:
            problems.append("P1: missing Live snapshot — run update")
        if md.count("```mermaid") < 3:
            problems.append("P1: few mermaid blocks — run update")
        if units.get("demigod-agent-coord.service") is False:
            problems.append("P0: coord service inactive")
        if not problems:
            improvements.append("On-disk diagram structure ok")
        mc = md.count("```mermaid")
    write_receipt("review")
    print(f"review ok problems={len(problems)}")
    for p in problems:
        print("!", p)
    sys.exit(0)

# update: write docs then receipt
DOC.parent.mkdir(parents=True, exist_ok=True)
# patch review section inside md with final problem list
old_review_marker = "## 8. Last auto-review (" + now_s + ")"
if old_review_marker in md:
    pre, _, _rest = md.partition(old_review_marker)
    prob_lines = "\n".join("- " + p for p in problems) if problems else "- (none)"
    imp_lines = "\n".join("- " + i for i in improvements) if improvements else "- (none)"
    md = (
        pre
        + old_review_marker
        + "\n\n**Problems**\n"
        + prob_lines
        + "\n\n**Improvements applied / suggested**\n"
        + imp_lines
        + "\n\n---\n\n## 9. Related maps\n\n"
        + "- Total workflow — `/api/maps/workflow`\n"
        + "- Website architecture — `/api/maps/website`\n"
        + "- Resources — `/api/maps/resources`\n"
        + "- **This map** — `/api/maps/agents` (lanes SoR)\n"
    )
DOC.write_text(md)
DOC2.write_text(md)
write_receipt("update")
print(
    "updated",
    DOC,
    "bytes=" + str(len(md)),
    "mermaid=" + str(md.count("```mermaid")),
    "problems=" + str(len(problems)),
    "foot=" + foot,
    "cycle=" + str(cycle),
)
for p in problems:
    print("!", p)
PY
