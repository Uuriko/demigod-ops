#!/usr/bin/env bash
# dg-selfstart — keep Grok/agent stack alive when chat dies
#   bin/dg-selfstart ensure|status|install|once
set -euo pipefail
export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.nvm/versions/node/v24.17.0/bin:/usr/bin:/bin:$PATH"
ROOT="${DEMIGOD_ROOT:-$HOME}"
cd "$ROOT"
cmd="${1:-ensure}"
if [[ -n "${2:-}" ]]; then
  echo "dg-selfstart: unknown argument $2 — try: bin/dg-selfstart $cmd" >&2
  exit 2
fi
case "$cmd" in
  ensure|heal|up) exec node demigod-selfstart.mjs ensure ;;
  status) exec node demigod-selfstart.mjs status ;;
  install)
    install -Dm644 systemd-user/demigod-funnel-watchdog.service "$HOME/.config/systemd/user/demigod-funnel-watchdog.service"
    systemctl --user daemon-reload
    systemctl --user enable --now demigod-selfstart.timer
    systemctl --user start demigod-selfstart.service
    systemctl --user list-timers demigod-selfstart.timer --no-pager
    node demigod-selfstart.mjs status
    ;;
  once) exec node demigod-selfstart.mjs ensure ;;
  *)
    echo "usage: bin/dg-selfstart ensure|status|install|once" >&2
    exit 2
    ;;
esac
