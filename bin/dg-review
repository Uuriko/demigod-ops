#!/usr/bin/env bash
# Demigod code review + bugfix (v2.1)
#
#   bin/dg-review
#   bin/dg-review --bug --gates
#   bin/dg-review --files a.mjs b.mjs
#   bin/dg-review --fix --dry-run
#   bin/dg-review --fix --rescan
#   bin/dg-review --fix --allow-foot
#   bin/dg-review --llm
#   bin/dg-review --full
#   bin/dg-review --catalog
#   bin/dg-review --only-rule eval-use,syntax
#   bin/dg-review --exclude-rule todo-marker
#   bin/dg-review --exclude '*.md'
#   bin/dg-review --fail-on medium
#   bin/dg-review --max 40
#   bin/dg-review --include-meta
#   bin/dg-review --untracked
#   node demigod-review-selftest.mjs
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec node "$ROOT/demigod-review.mjs" "$@"
