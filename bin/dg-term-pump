#!/usr/bin/env bash
# Type coord prompts into interactive Claude/Grok tmux panes — only when headless is idle.
# Avoids double-work with demigod-agent-coord headless workers.
# Stop: touch /tmp/dg-busy/coord/term-pump.STOP
set -euo pipefail
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      echo "usage: dg-term-pump  (no flags; TERM_PUMP_SEC env optional; intentionally disabled by default)"
      exit 0
      ;;
    *)
      echo "dg-term-pump: unknown argument $arg — try: dg-term-pump" >&2
      exit 2
      ;;
  esac
done
export PATH="${HOME}/.local/bin:${HOME}/bin:${PATH}"
DIR=/tmp/dg-busy/coord
STOP=$DIR/term-pump.STOP
LOG=$DIR/term-pump.log
# Default 5m — interactive is backup, not a second thrash lane
INTERVAL="${TERM_PUMP_SEC:-300}"
mkdir -p "$DIR"
rm -f "$STOP"
echo $$ >"$DIR/term-pump.pid"

bin/dg-term-type ensure >>"$LOG" 2>&1 || true

headless_busy() {
  local f="$1"
  [[ -f "$f" ]] || return 1
  local p; p=$(tr -d ' \n' <"$f" || true)
  [[ -n "${p:-}" ]] && kill -0 "$p" 2>/dev/null
}

n=0
while [[ ! -f "$STOP" ]]; do
  n=$((n+1))
  # Refresh shared digest if coord tool present
  bin/dg-agent-coord brief >/dev/null 2>&1 || true

  claude_h=0; grok_h=0
  headless_busy "$DIR/claude.pid" && claude_h=1
  headless_busy "$DIR/grok.pid" && grok_h=1

  # Skip interactive inject when headless already covering that lane
  if (( claude_h == 0 )); then
    prompt="Demigod interactive tick $n · LANE=website. Read /tmp/dg-busy/coord/digest.md. North star: website+Demigod product first (docs/DEMIGOD-ANTI-BLOAT-SEARCHES.md). Do 1 concrete website win (Ponytail). Foot via DG_LOCK_OWNER=term-claude bin/dg-lock. verify:source if foot/head. Write /tmp/dg-busy/coord/term-claude-last.json {ok,at,did,lane:\"website\"}. No auto-DM/game."
    bin/dg-term-type claude "$prompt" >>"$LOG" 2>&1 || true
    echo "[$(date -Iseconds)] pumped claude n=$n" >>"$LOG"
  else
    echo "[$(date -Iseconds)] skip claude (headless busy) n=$n" >>"$LOG"
  fi

  if (( grok_h == 0 )); then
    prompt="Demigod interactive tick $n · LANE=gates+funnel. Read /tmp/dg-busy/lead-system/FOCUS.md + /tmp/dg-busy/coord/digest.md. Prefer implement ONE funnel/lead automation tool fix; else verify gates. Write /tmp/dg-busy/coord/term-grok-last.json {ok,at,did,lane:\"gates\"}. No auto-DM/game."
    bin/dg-term-type grok "$prompt" >>"$LOG" 2>&1 || true
    echo "[$(date -Iseconds)] pumped grok n=$n" >>"$LOG"
  else
    echo "[$(date -Iseconds)] skip grok (headless busy) n=$n" >>"$LOG"
  fi

  sleep "$INTERVAL"
done
rm -f "$DIR/term-pump.pid"
