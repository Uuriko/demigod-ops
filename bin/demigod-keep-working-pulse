#!/usr/bin/env bash
# Pulse: ensure useful-loop up + write peer nudge while KEEP_WORKING.
set -euo pipefail
BUSY="${DEMIGOD_BUSY:-/tmp/dg-busy}"
mkdir -p "$BUSY"
if [[ ! -f "$BUSY/KEEP_WORKING" ]]; then
  exit 0
fi
# Ensure loop never left STOP'd
rm -f "$BUSY/useful-loop.STOP"
systemctl --user is-active demigod-useful-loop.service >/dev/null 2>&1 || systemctl --user start demigod-useful-loop.service || true
TS=$(date -Iseconds)
cat > "$BUSY/keep-working-nudge.md" <<MD
# KEEP_WORKING pulse $TS

Standing user order: loops/goals must not self-stop. Design track: make trydemigod.com the best-designed honest SF talent site.

## Constraints
- No publish / outbound / money without current-request auth
- Ponytail + maximize-weakness
- Disk SoR: demigod-head-styles.css, demigod-foot-core.js, demigod-head-minimal.html
- Truth: bin/dg truth

## Next for any agent reading this
1. Pick one high-impact design defect (hero hierarchy, dual-path equality, type/space, nav clutter, form WIZ polish, mobile).
2. Fix on disk at /home/potter (and worktree if diverged).
3. Verify smallest gate.
4. Do not clear KEEP_WORKING. Do not mark open-ended goals complete.
MD
# Append pulse log
echo "$TS pulse useful-loop=$(systemctl --user is-active demigod-useful-loop.service 2>/dev/null || echo unknown)" >> "$BUSY/keep-working-pulse.log"
# Soft-restart useful-loop if dead
if ! systemctl --user is-active demigod-useful-loop.service >/dev/null 2>&1; then
  systemctl --user start demigod-useful-loop.service || true
fi
exit 0
