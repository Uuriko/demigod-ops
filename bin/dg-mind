#!/usr/bin/env bash
# dg-mind — Grok nonstop mind (ideas + plans + optional do)
#   bin/dg-mind start|stop|status|once|ideas|want|pulse
set -euo pipefail
export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.nvm/versions/node/v24.17.0/bin:/usr/bin:/bin:$PATH"
ROOT="${DEMIGOD_ROOT:-$HOME}"
BUSY="${DEMIGOD_BUSY:-/tmp/dg-busy}"
UNIT=demigod-nonstop-mind.service
cd "$ROOT"
cmd="${1:-status}"
if [[ -n "${2:-}" ]]; then
  echo "dg-mind: unknown argument $2 — try: bin/dg-mind $cmd" >&2
  exit 2
fi
case "$cmd" in
  start)
    rm -f "$BUSY/mind.STOP"
    systemctl --user daemon-reload
    systemctl --user enable --now "$UNIT"
    systemctl --user status "$UNIT" --no-pager | head -18
    ;;
  stop)
    date -Iseconds >"$BUSY/mind.STOP"
    systemctl --user stop "$UNIT" 2>/dev/null || true
    echo "mind stopped"
    ;;
  restart)
    rm -f "$BUSY/mind.STOP"
    systemctl --user restart "$UNIT"
    systemctl --user is-active "$UNIT"
    ;;
  status)
    systemctl --user is-active "$UNIT" 2>/dev/null || true
    systemctl --user status "$UNIT" --no-pager 2>/dev/null | head -16 || true
    echo "--- pulse ---"
    head -30 "$BUSY/mind/pulse.md" 2>/dev/null || echo "(no pulse yet)"
    echo "STOP=$( [ -f "$BUSY/mind.STOP" ] && echo yes || echo no )"
    ;;
  once)
    exec node demigod-nonstop-mind.mjs once --do
    ;;
  think)
    exec node demigod-nonstop-mind.mjs once
    ;;
  ideas)
    exec node demigod-idea-engine.mjs
    ;;
  promote)
    exec node demigod-idea-engine.mjs --promote
    ;;
  want)
    exec cat DEMIGOD-GROK-WANT.md
    ;;
  pulse)
    exec cat "$BUSY/mind/pulse.md"
    ;;
  *)
    echo "usage: bin/dg-mind start|stop|restart|status|once|think|ideas|promote|want|pulse" >&2
    exit 2
    ;;
esac
