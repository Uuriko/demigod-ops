#!/usr/bin/env bash
# One cycle of productive Demigod work (safe to cron/entr)
set -euo pipefail
cd /home/potter
bin/dg-swarm-busy
# lightweight user-path smoke via curl (no browser thrash)
node -e "
const u='https://www.trydemigod.com/?cb='+Date.now();
fetch(u).then(r=>r.text()).then(h=>{
  const cdn=(h.match(/files\\.catbox\\.moe\\/[a-z0-9]+\\.js/)||[])[0];
  const pub=(h.match(/Last Published:[^<]+/)||[])[0];
  console.log(JSON.stringify({ok:!!cdn,cdn,pub:pub&&pub.slice(0,80)}));
}).catch(e=>{console.error(e);process.exit(1)})
" | tee /tmp/dg-busy/live-curl.json
# if foot lock free and source != live, note only (don't auto-edit)
python3 - <<'PY'
import re, json, pathlib
html=pathlib.Path('/tmp/dg-busy/live-curl.json').read_text() if pathlib.Path('/tmp/dg-busy/live-curl.json').exists() else ''
print('cycle ok')
PY
bin/dg-hygiene >/tmp/dg-busy/hygiene.out 2>&1 || true
echo cycle_complete $(date -Iseconds)
