#!/usr/bin/env bash
# Continuous Claude Code test loop — full permissions, no prompts.
# Stop: bin/claude-yolo-loop stop
set -euo pipefail
ROOT="${DEMIGOD_ROOT:-$HOME}"
BUSY="${DEMIGOD_BUSY:-/tmp/dg-busy}"
LOG="$BUSY/claude-yolo-loop.log"
PIDF="$BUSY/claude-yolo-loop.pid"
STOP="$BUSY/claude-yolo.STOP"
STATE="$BUSY/claude-yolo-state.json"
INBOX="$BUSY/claude-yolo-inbox"
OUTDIR="$BUSY/claude-yolo-out"
mkdir -p "$BUSY" "$INBOX" "$OUTDIR"
export PATH="${HOME}/.local/bin:${HOME}/bin:${HOME}/.nvm/versions/node/v24.17.0/bin:/usr/bin:/bin:${PATH}"
cd "$ROOT"

cmd="${1:-run}"
if [[ "$cmd" == "stop" ]]; then
  date -Iseconds >"$STOP"
  if [[ -f "$PIDF" ]]; then
    kill "$(cat "$PIDF")" 2>/dev/null || true
    rm -f "$PIDF"
  fi
  echo "stopped"
  exit 0
fi
if [[ "$cmd" == "status" ]]; then
  echo "stop=$([[ -f $STOP ]] && echo yes || echo no)"
  echo "pid=$(cat "$PIDF" 2>/dev/null || echo none)"
  [[ -f "$STATE" ]] && cat "$STATE" || true
  tail -30 "$LOG" 2>/dev/null || true
  exit 0
fi

rm -f "$STOP"
echo $$ >"$PIDF"
cycle=0
SLEEP_SEC="${CLAUDE_YOLO_SLEEP_SEC:-60}"
MODEL="${CLAUDE_YOLO_MODEL:-sonnet}"
# 999 at 60s/cycle = the "nonstop" loop silently dies after ~17h and never returns.
# It was at cycle 686/999 when this was found. Effectively unbounded now; use
# `bin/claude-yolo-loop stop` (or the STOP file) to end it deliberately.
MAX="${CLAUDE_YOLO_MAX_CYCLES:-1000000}"
TIMEOUT_SEC="${CLAUDE_YOLO_TIMEOUT_SEC:-240}"

log() { echo "[$(date -Iseconds)] $*" | tee -a "$LOG"; }

# Run one Claude worker; stdout (incl stderr) is the answer, caller redirects it.
run_claude() { # $1 = prompt
  timeout "$TIMEOUT_SEC" claude -p "$1" \
    --dangerously-skip-permissions \
    --permission-mode bypassPermissions \
    --model "$MODEL" \
    --add-dir "$ROOT" 2>&1
}

# These were 5 read-only "summarize / no action taken" checks. 686 cycles produced
# ZERO fixes — the loop never stopped, it just never did anything. A status check
# that says "pass" forever is indistinguishable from not running. Every task below
# must OBSERVE by running (browser/execute), not by grep — and must end in a fix,
# a real finding appended to the queue, or an explicit "nothing found".
DG_RULES="HARD RULES: never send a DM or any outbound message (drafts-only; an agent already broke this). Never edit demigod-foot-core.js without holding the foot lock (node demigod-foot-lock.mjs claim; release with DG_LOCK_TOKEN env — --token= is silently broken, full token only in /tmp/dg-busy/foot-lock.json). Never let demigod-head-minimal.html exceed 50000 chars — past it Webflow returns 200+saved but silently keeps the OLD head and every ship no-ops. If you edit foot-core, bump ALL FOUR version markers together (__dgFootVer, dg-foot-vNNN-core, dgFootVersion, 'foot vNNN') and run node demigod-foot-smoke.mjs. Never remove a runtime copy scrub (the Webflow canvas still carries dishonest copy; scrubs are the only thing hiding it). In CDP tests always emulateMediaFeatures prefers-reduced-motion:no-preference — the :9223 Chrome defaults to reduce and makes animations look dead. VERIFY BY RUNNING, never by grep or diff. Report only what you verified; correct yourself when wrong. Append findings to /tmp/dg-busy/dg-findings.jsonl as one {at,task,finding,evidence,severity} per line, and write a receipt to /tmp/dg-busy/claude-yolo-last.json."

tasks=(
  "Demigod. $DG_RULES TASK: live browser defect sweep. Using puppeteer-core against CDP http://127.0.0.1:9223, load https://www.trydemigod.com/ and /?p=events and /?p=mud. Record console errors, failed requests, and any element with computed opacity<0.05 that a visitor would never see. Report each as a finding with the actual error text. If you find zero, say zero — do not invent."
  "Demigod. $DG_RULES TASK: run the selftests that are RED and diagnose ONE by EXECUTING it, not reading it: node demigod-tools-os-selftest.mjs, demigod-wiz-ownership-selftest.mjs, demigod-truth-lock-selftest.mjs. Print the actual FAIL list. For the first failure, determine whether it is a real defect or a STALE EXPECTATION (e.g. tools-os asserts verify-source still 'locks v507' while disk is v631+). If stale, fix or retire that one assertion and rerun to prove it green. Do not mass-delete."
  "Demigod. $DG_RULES TASK: guard the head budget. wc -c demigod-head-minimal.html (cap 50000, silent failure past it). If >49000, reclaim bytes — a parallel agent keeps re-adding catbox .jpg favicon links (alnuu9/op4166/5hnii5); ensureLogo() in foot-core re-injects an SVG icon at boot so those head links are redundant. Report bytes before/after and headroom."
  "Demigod. $DG_RULES TASK: mobile + a11y sweep at 390x844 via CDP. Load / and /?p=events and /?p=mud. Check: horizontal overflow (scrollWidth>innerWidth), tap targets under 48px, inputs missing a label/aria-label, live regions missing aria-live. TAP-TARGET RULES — obey these or you generate pure noise (a naive sweep reported 33 findings of which 31 were false): (1) SKIP offscreen/clipped elements — #dg-skip is a skip link at 1px positioned offscreen until focused, it is correct as-is and is NOT a finding; (2) apply the WCAG 2.5.8 'inline' exception — a link inside a sentence of text is EXEMPT (detect: computed display includes 'inline' AND parent text is meaningfully longer than the link's own text); (3) only report elements that are visible, non-inline, and genuinely tappable. Known real+minor, do not re-report: a.nav_logo 40px, a.footer_link 37px. Report concrete selectors with measured px, not generalities. If nothing new, say zero."
  "Demigod. $DG_RULES TASK: version + ship integrity. Run node demigod-foot-smoke.mjs and node demigod-truth.mjs --json. Confirm all four foot version markers agree (a non-atomic bump caused an all-day drift; the marker FORMAT drifts between dgFootVersion='vNNN' and dgFootVersion = 'vNNN'). If markers disagree, fix them under the foot lock and prove foot-smoke passes. Never paste-publish."
  "Demigod. $DG_RULES TASK: verify one claim nobody has verified. Read /tmp/dg-busy/dg-findings.jsonl and the newest docs/process/*.md. Pick ONE unverified claim and prove or disprove it by RUNNING the command. Three inherited 'known bugs' turned out already fixed, and an 11,781-line deletion audit was wrong — so disproving a claim is a real result. Report which claim and the evidence."
)

log "START model=$MODEL sleep=${SLEEP_SEC}s timeout=${TIMEOUT_SEC}s max=$MAX"

while [[ ! -f "$STOP" ]] && (( cycle < MAX )); do
  # 1) Dynamic requests from Grok. Drop a prompt at $INBOX/<id>.req
  #    (write <id>.tmp then `mv` to <id>.req so we never read a half-written file).
  #    Answer lands at $OUTDIR/<id>.res.
  req=$(ls -1tr "$INBOX"/*.req 2>/dev/null | head -1 || true)
  if [[ -n "$req" ]]; then
    base=$(basename "$req" .req)
    run="$INBOX/$base.run"; out="$OUTDIR/$base.res"
    mv "$req" "$run" 2>/dev/null || continue   # lost the race to another claimant
    cycle=$((cycle + 1))
    log "REQ $base"
    printf '{"at":"%s","cycle":%s,"req":"%s","status":"running"}\n' "$(date -Iseconds)" "$cycle" "$base" >"$STATE"
    set +e
    run_claude "$(cat "$run")" >"$out"
    ec=$?
    set -e
    rm -f "$run"
    log "REQ $base exit=$ec -> $out"
    printf '{"at":"%s","cycle":%s,"req":"%s","status":"done","exit":%s,"out":"%s"}\n' "$(date -Iseconds)" "$cycle" "$base" "$ec" "$out" >"$STATE"
    continue   # drain any remaining requests before idling
  fi

  # 2) No requests: dogfood rotation keeps the link warm + refreshes claude-yolo-last.json
  cycle=$((cycle + 1))
  idx=$(( (cycle - 1) % ${#tasks[@]} ))
  prompt="${tasks[$idx]}"
  log "CYCLE $cycle task_idx=$idx"
  printf '{"at":"%s","cycle":%s,"taskIdx":%s,"status":"running"}\n' "$(date -Iseconds)" "$cycle" "$idx" >"$STATE"
  set +e
  run_claude "$prompt" >>"$LOG"
  ec=$?
  set -e
  log "CYCLE $cycle exit=$ec"
  printf '{"at":"%s","cycle":%s,"taskIdx":%s,"status":"done","exit":%s}\n' "$(date -Iseconds)" "$cycle" "$idx" "$ec" >"$STATE"

  # responsive idle: wake early on STOP or a freshly-dropped request
  for ((s=0; s<SLEEP_SEC; s++)); do
    [[ -f "$STOP" ]] && break
    ls "$INBOX"/*.req >/dev/null 2>&1 && break
    sleep 1
  done
done

log "STOPPED cycles=$cycle"
rm -f "$PIDF"
printf '{"at":"%s","cycle":%s,"status":"stopped"}\n' "$(date -Iseconds)" "$cycle" >"$STATE"
