#!/usr/bin/env bash
# One-line health verdict for the Demigod autopilot/swarm. Cheap, no model needed.
#   dg-autopilot-health
set -uo pipefail
HOME="${HOME:-/home/potter}"
cd /home/potter
export PATH="$HOME/.local/bin:$HOME/bin:$HOME/.nvm/versions/node/v24.17.0/bin:/usr/bin:/bin:${PATH:-}"
live=$(curl -s -o /dev/null -w '%{http_code}' --max-time 12 https://www.trydemigod.com 2>/dev/null || echo ERR)
# gates: the coord rewrites footer-lite.html mid-ship, so a single verify:source can catch a
# transient. Retry once -- but a retry that goes green is NOT the same as never having failed.
# This used to report plain PASS when run 1 failed and run 2 passed, erasing the flap entirely.
# demigod-favicon-ship.mjs:60 named that exact sin: "dg-autopilot-health papers over the whole
# category by retrying verify:source once and calling a transient fail clean." It was right.
# So a disagreement between the two runs is its own state (CHURN), not clean and not a fault.
# Keep it DISTINCT from FAIL: a real break sits still and fails both runs, and stays FAIL below.
gates=PASS
if ! node demigod-verify-source.mjs >/dev/null 2>&1; then
  sleep 3
  if node demigod-verify-source.mjs >/dev/null 2>&1; then gates=CHURN; else gates=FAIL; fi
fi
# A FAIL only means something if the files verify:source READS are quiescent. The retry above waits
# 3s, which catches a sub-second write tear -- but an AGENT editing the head takes MINUTES. Measured
# 2026-07-17: a head edit ran 05:01:49->05:05:47 and during it 6 head:* gates failed on THREE
# consecutive runs spanning 4 min, then went green on their own once the agent finished. So
# "failed twice, 3s apart" does NOT mean sustained, and the 3s window is ~80x too short to tell an
# edit-in-progress from a real regression. Cost: a full cycle chasing 6 phantom failures.
# Quiescence is the honest test -- if a guarded file is still moving, no verdict about it is final.
# NB: `find` here is bfs, not GNU findutils -- it rejects EVERY -newermt form. With stderr
# discarded that reads as "no files changed", i.e. this check would silently never fire. stat+date
# is portable and actually testable.
if [ "$gates" = FAIL ]; then
  now=$(date +%s); churn=""
  for f in demigod-head-minimal.html demigod-foot-core.js demigod-footer-lite.html demigod-head-styles.css; do
    m=$(stat -c %Y "$f" 2>/dev/null) || continue
    [ $((now - m)) -lt 120 ] && { churn="$f"; break; }
  done
  [ -n "$churn" ] && gates=CHURN  # someone is mid-edit; re-judge next run, don't cry wolf
fi
# Name the dead service instead of counting to a threshold. The old form counted actives and
# flagged only `svc -lt 3`, to "tolerate ONE transient blip (a drainer mid-restart)" -- but that
# tolerance is indiscriminate: claude-yolo died 2026-07-16T23:48 and this printed svc=3/4 verdict=OK
# for the 2h it stayed dead. A blip and a corpse looked identical.
# systemd already distinguishes them: a unit mid-restart reports `activating`, a dead one reports
# `inactive`/`failed`. So tolerate `activating` explicitly and treat anything else as down.
# demigod-dash included: it was NOT watched, and sat failed 8h (exit 98/EADDRINUSE) while an
# orphaned `node demigod-agent-dashboard.mjs` (PPID 1) held :9878. The dashboard answered 200 the
# whole time, so nothing looked wrong -- but systemd could never reclaim the port, and the process
# actually serving it was supervised by no one.
# demigod-events-bot: same class of bug via demigod-events-online.mjs startApp() detached+unref
# (NRestarts 1740+, MainPID=0, orphan PPID 1 on :3460). Only add to watch AFTER spawner prefers
# the unit — a permanently red signal is worth less than no signal.
SVCS=(demigod-agent-coord claude-yolo demigod-dash demigod-events-bot swarm-drainer@grok swarm-drainer@codex swarm-drainer@claude)
down=()
for s in "${SVCS[@]}"; do
  st=$(systemctl --user is-active "$s" 2>/dev/null || true)
  case "$st" in
    active | activating | reloading) ;;
    *) down+=("$s=${st:-unknown}") ;;
  esac
done
svc=$(( ${#SVCS[@]} - ${#down[@]} ))
svc_total=${#SVCS[@]}
auto=$([ -f /tmp/dg-busy/claude-autopilot.ON ] && [ ! -f /tmp/dg-busy/swarm.STOP ] && echo armed || echo off)
# truth: only a REAL drift is disk vs a NUMERIC live version lagging >2 (1-2 = normal continuous ship;
# live=null = transient probe fail, not a fault). Never flag on a null/unknown live.
truth=$(node -e 'try{const t=require("/tmp/dg-busy/truth.json");const d=+t.foot?.ver,l=+t.live?.footVer;
const liveOk=Number.isFinite(l)&&l>100;  // real versions are 150+; null/0 = live probe did not resolve
if(t.fullyShipped)process.stdout.write("shipped v"+d);
else if(!liveOk)process.stdout.write("live-probe-pending v"+d);       // NOT a fault — probe unresolved
else if(d-l>15)process.stdout.write("STUCK disk v"+d+" live v"+l);    // live genuinely not catching up
else process.stdout.write("churn-lag v"+d+"/"+l);                      // coord bumps disk faster than it ships — perpetual, normal
}catch(e){process.stdout.write("?")}' 2>/dev/null)
drift=$(printf '%s' "$truth" | grep -c STUCK)
# svc: ANY service not active/activating is a problem, and the message says which one.
# gates=CHURN is NOT a fault (mid-edit, verdict deferred) -- test for FAIL, not for "not PASS".
verdict=OK; { [ "$live" != 200 ] || [ "$gates" = FAIL ] || [ ${#down[@]} -gt 0 ] || [ "$drift" != 0 ]; } && verdict=CHECK
echo "[$verdict] live=$live gates=$gates svc=$svc/$svc_total${down[*]+ down=${down[*]}} autopilot=$auto truth=$truth"
[ "$verdict" = OK ] && exit 0 || exit 1
