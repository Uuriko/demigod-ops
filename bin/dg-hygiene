#!/usr/bin/env bash
# dg-hygiene — laptop + CDP tab hygiene (keep Chrome :9223, keep core Webflow tabs)
# Prefer: bin/dg-hygiene   or   node demigod-laptop-hygiene.mjs --prune
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CLOSED=0
KILLED=0

echo "=== Demigod hygiene $(date -Iseconds) ==="

# Canonical prune (keeps 1 live, 1 designer, 1 custom-code, 1 ops-dash)
if [ -f "$ROOT/demigod-laptop-hygiene.mjs" ]; then
  node "$ROOT/demigod-laptop-hygiene.mjs" --prune "$@" || true
fi

# --- Kill only known orphan test PIDs (never match this script name loosely) ---
while read -r pid cmd; do
  [ -z "${pid:-}" ] && continue
  case "$cmd" in
    *dg-hygiene*) continue ;;
    *agent-dev.sh*) continue ;;
  esac
  if echo "$cmd" | grep -Eq 'demigod-(ux-flow-audit|form-e2e|wiz-cdp|forms-full|wizard-playtest|full-audit|mobile-audit|design-audit|form-submit|button-audit)|playwright.*install'; then
    kill "$pid" 2>/dev/null && KILLED=$((KILLED+1)) && echo "kill demigod-test $pid"
  fi
done < <(ps -eo pid=,args= 2>/dev/null)

# Headless chromium/chrome launched by Playwright (has --headless= in args)
while read -r pid cmd; do
  [ -z "${pid:-}" ] && continue
  if echo "$cmd" | grep -Eq -- '--headless( |=|$)'; then
    # Do not kill CDP-managed Chrome if it somehow has headless — CDP uses non-headless typically
    if echo "$cmd" | grep -Eq 'remote-debugging-port=9223'; then
      continue
    fi
    kill "$pid" 2>/dev/null && KILLED=$((KILLED+1)) && echo "kill headless $pid"
  fi
done < <(ps -eo pid=,args= 2>/dev/null | grep -E 'chrome|chromium' | grep -v grep)

# --- CDP tab close ---
python3 - <<'PY'
import json, urllib.request, sys
CLOSED = 0
try:
    tabs = json.load(urllib.request.urlopen("http://127.0.0.1:9223/json/list", timeout=3))
except Exception as e:
    print("CDP unavailable:", e)
    sys.exit(0)

print("CDP targets before:", len(tabs))
pages = [t for t in tabs if t.get("type") == "page"]
print("pages before:", len(pages))

# Prefer keep list (budget ~6)
keep_patterns = (
    "trydemigod.com",
    "talentlink-sf.design.webflow.com",
    "webflow.com/dashboard",
    "webflow.com/sites",
)
junk_patterns = (
    "litter.catbox",
    "catbox.moe/wifomh",
    "docs.google.com/forms",
    "127.0.0.1:8777",
    "auth.openai.com",
    "localhost:1455",
    "chrome-error://",
)

kept_demigod = 0
kept_webflow = 0
for t in list(pages):
    url = t.get("url") or ""
    tid = t.get("id")
    is_junk = any(j in url for j in junk_patterns)
    is_keep = False
    if "trydemigod.com" in url:
        if kept_demigod < 1 and not is_junk:
            is_keep = True
            kept_demigod += 1
    elif any(k in url for k in ("talentlink-sf.design.webflow.com", "webflow.com/dashboard", "webflow.com/sites")):
        if kept_webflow < 2 and not is_junk:
            is_keep = True
            kept_webflow += 1
    if is_junk or not is_keep:
        if url in ("about:blank", "chrome://newtab/"):
            continue
        try:
            urllib.request.urlopen(f"http://127.0.0.1:9223/json/close/{tid}", timeout=2).read()
            print("closed", url[:100])
            CLOSED += 1
        except Exception as e:
            print("fail", url[:60], e)

# Cap total pages at 6
try:
    tabs = json.load(urllib.request.urlopen("http://127.0.0.1:9223/json/list", timeout=3))
except Exception:
    tabs = []
pages = [t for t in tabs if t.get("type") == "page"]
if len(pages) > 6:
    for t in pages[6:]:
        url = t.get("url") or ""
        if any(k in url for k in keep_patterns):
            continue
        try:
            urllib.request.urlopen(f"http://127.0.0.1:9223/json/close/{t['id']}", timeout=2).read()
            print("closed over-budget", url[:100])
            CLOSED += 1
        except Exception:
            pass

try:
    tabs = json.load(urllib.request.urlopen("http://127.0.0.1:9223/json/list", timeout=3))
    pages = [t for t in tabs if t.get("type") == "page"]
    print("pages after:", len(pages))
    for t in pages:
        print(" ", (t.get("url") or "")[:100])
except Exception as e:
    print("list fail", e)
print("tabs_closed", CLOSED)
PY

echo "killed_approx_done"
free -h | head -2
echo "=== hygiene complete ==="
