#!/usr/bin/env bash
# Emit keep-alive lines for Grok chat monitor (one line every INTERVAL seconds).
# Stop: touch /tmp/dg-busy/coord/chat-heartbeat.STOP
set -euo pipefail
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      echo "usage: dg-chat-heartbeat  (no flags; CHAT_HEARTBEAT_SEC env optional)"
      exit 0
      ;;
    *)
      echo "dg-chat-heartbeat: unknown argument $arg — try: dg-chat-heartbeat" >&2
      exit 2
      ;;
  esac
done
DIR=/tmp/dg-busy/coord
STOP=$DIR/chat-heartbeat.STOP
INTERVAL="${CHAT_HEARTBEAT_SEC:-45}"
mkdir -p "$DIR"
rm -f "$STOP"
n=0
while [[ ! -f "$STOP" ]]; do
  n=$((n+1))
  # single line, unbuffered
  printf 'CHAT_TICK n=%s at=%s action=continue_demigod_website workers=%s\n' \
    "$n" "$(date -Iseconds)" \
    "$(bin/dg-agent-coord status 2>/dev/null | grep -E 'claude=|codex=|grok=|supervisor=' | tr '\n' ' ')"
  sleep "$INTERVAL"
done
