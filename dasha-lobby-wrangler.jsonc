{
  // Deploy: CLOUDFLARE_API_TOKEN=… npm run dasha:lobby:deploy
  // Live: https://lobby.getdasha.com  ·  wss://lobby.getdasha.com/ws
  // Faucet secret: wrangler secret put FAUCET_KEYPAIR  (do not invent or commit a value)
  // Optional var: FAUCET_AMOUNT_RAW (default 100000000)
  // Optional var: FAUCET_RENT_CAP_LAMPORTS (default 20 * live ATA rent)
  // Optional var: FAUCET_SOL_FLOOR_LAMPORTS (default live ATA rent + fee)
  // Optional var: FAUCET_TOKEN_CAP_RAW (default 20 * amountRaw, daily)
  // Optional var: FAUCET_PAUSED=1 (503 before send)
  "name": "dasha-lobby",
  "account_id": "5a919d6c1785d47e15e10c24450a8ff7",
  "workers_dev": true,
  "routes": [
    { "pattern": "lobby.getdasha.com/*", "zone_name": "getdasha.com" },
    { "pattern": "www.getdasha.com/*", "zone_name": "getdasha.com" }
  ],
  "main": "dasha-lobby-worker.mjs",
  "assets": { "directory": "./dasha-worker-assets", "binding": "ASSETS", "run_worker_first": true },
  "compatibility_date": "2026-08-06",
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBY",
        "class_name": "DashaLobby"
      },
      {
        "name": "FAUCET",
        "class_name": "DashaFaucet"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DashaLobby"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DashaFaucet"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://www.getdasha.com,https://getdasha.com,https://lobby.getdasha.com,http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:8787,http://localhost:8787",
    "MINT": "53uxQtB9pcjWvCHguz3JTTndvuKqGxhrD37EetnCpump"
  }
}
