[Unit]
Description=Named Cloudflare tunnel for gated Demigod DIE
# BindsTo, not Wants: a tunnel that outlives its origin publishes a dead app behind a live
# hostname. Wants= is advisory — on 2026-08-18 this unit held four ready edge connections while
# demigod-die-web.service was inactive. Requires= would not have caught it either, because the app
# stopping cleanly is not a failure to propagate. BindsTo= stops this tunnel with the origin.
BindsTo=demigod-die-web.service
After=network-online.target demigod-die-web.service
# The arming marker, deliberately absent by default. die-gate-ready only means a gate secret exists;
# it is not consent to publish. Exposure is armed by die-tunnel-ready and nothing else.
ConditionPathExists=%h/.config/demigod/die-tunnel-ready
ConditionPathExists=%h/.config/demigod/die-tunnel.token

[Service]
Type=simple
WorkingDirectory=/home/potter
ExecStart=/home/potter/.local/bin/cloudflared tunnel --no-autoupdate run --token-file %h/.config/demigod/die-tunnel.token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
