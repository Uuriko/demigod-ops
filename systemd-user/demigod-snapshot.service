[Unit]
Description=Demigod snapshot — local copy of the files git cannot restore
# Without this a failing nightly job is invisible: systemd marks it failed and nothing
# reads that, so a silent job and a broken one look identical from outside.
OnFailure=demigod-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:%h/bin:/usr/bin:/bin
Environment=DEMIGOD_ROOT=%h
Environment=DG_SNAPSHOT_DIR=/var/tmp/demigod-snapshots
ExecStart=%h/bin/dg-snapshot
