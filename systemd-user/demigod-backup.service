[Unit]
Description=Demigod backup — restic snapshot of the files git cannot restore

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:%h/bin:/usr/bin:/bin
Environment=DEMIGOD_ROOT=%h
Environment=DEMIGOD_BUSY=/tmp/dg-busy
# Set these two before enabling the timer — dg-backup fails closed without them.
# Environment=DG_BACKUP_REPO=/media/potter/backup/demigod
# Environment=RESTIC_PASSWORD_FILE=%h/.config/demigod/restic-password
ExecStart=%h/bin/dg-backup
